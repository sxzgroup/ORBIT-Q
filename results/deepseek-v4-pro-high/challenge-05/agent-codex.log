{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax, jax.numpy as jnp\nimport numpy as np\nfrom functools import partial\ntc.set_backend('jax')\nn=4\n\ndef gate1(a):\n    I=tc.gates._i_matrix.astype(np.complex64)\n    X=tc.gates._x_matrix.astype(np.complex64)\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return ca*I + sa*X\n\ndef gate2(b):\n    I4=tc.gates._ii_matrix.astype(np.complex64)\n    ZZ=tc.gates._zz_matrix.astype(np.complex64)\n    cb=jnp.cosh(b); sb=jnp.sinh(b)\n    return cb*I4 + sb*ZZ\n\ndef build(params):\n    a=params[:n].reshape(-1) # n? use each layer n? just dummy\n    b=params[n:]\n    c=tc.Circuit(n)\n    # initialize |+>\n    for i in range(n): c.H(i)\n    # apply one layer filter all qubits\n    for i in range(n):\n        c.apply_general_gate(tc.Gate(gate1(a[i])), i)\n    # apply bonds even\n    for i in range(0,n-1,2):\n        c.apply_general_gate(tc.Gate(gate2(b[i//2])), i, i+1)\n    return c\n\nparams=jnp.array([0.1]*n+[0.2]*(n//2), dtype=jnp.float32)\nc=build(params)\nprint(c.state())\nprint(c.state().shape)\n\ndef energy(params):\n    c=build(params)\n    st=c.state()\n    st=st/jnp.sqrt(jnp.vdot(st,st))\n    # local Z and X via operator expectation maybe use dense small H\n    from tensorcircuit.templates.measurements import operator_expectation\n    from tensorcircuit import quantum as qu\n    g=tc.templates.graphs.Line1D(n)\n    H=qu.heisenberg_hamiltonian(g,hzz=-1.0,hx=-1.1,hxx=0,hyy=0,hy=0,hz=0,sparse=True,numpy=False)\n    return operator_expectation(c,H)\nprint('e', energy(params))\nprint('grad', jax.grad(energy)(params))\n# jit\nprint('jit grad', jax.jit(jax.grad(energy))(params))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
