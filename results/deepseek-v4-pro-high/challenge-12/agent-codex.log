{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os\nos.environ['JAX_ENABLE_X64']='1'\nimport jax\nprint('x64',jax.config.x64_enabled)\nimport jax.numpy as jnp\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\ntc.set_backend('jax')\nprint('dtype',tc.dtypestr, tc.rdtypestr)\n\nn=4\nn_layer=2\n# gates per layer = n-1 (but each layer only alternating; total 2*(n-1))\n# parameters arranged per gate index sequential over layers\nng=(n-1)*n_layer # 6\ntheta=jnp.zeros(ng*15,dtype=jnp.float64)\n\ndef apply_circuit(theta):\n    c=tc.MPSCircuit(n)\n    c.x(1); c.x(3)\n    for layer in range(n_layer):\n        bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n        for bi,b in enumerate(bonds):\n            # gate position layer*(n-1)+b maybe\n            p=theta[(layer*(n-1)+b)*15:(layer*(n-1)+b+1)*15]\n            g=gates.su4_gate(p)\n            c.apply_adjacent_double_gate(g,b,b+1)\n    return c\n\ndef loss(theta):\n    c=apply_circuit(theta)\n    target=tc.MPSCircuit(n) # |0000> bra\n    return jnp.real(c.proj_with_mps(target, conj=True))\n\n# identity params -> circuit |0101>; overlap with |0000> should 0.\nprint('identity loss', loss(theta))\nprint('grad norm', jnp.linalg.norm(jax.grad(loss)(theta)))\n# compare Neel target overlap 1\ndef loss_neel(theta):\n    c=apply_circuit(theta)\n    t=tc.MPSCircuit(n); t.x(1); t.x(3)\n    return jnp.real(c.proj_with_mps(t, conj=True))\nprint('neel loss', loss_neel(theta))\nprint('grad neel', jax.grad(loss_neel)(theta)[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
