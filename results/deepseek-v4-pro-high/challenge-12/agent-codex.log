{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train_test.py <<'PY'\nimport os,time,pickle\nimport jax, jax.numpy as jnp\nimport numpy as np\nimport optax\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nimport quimb.tensor as qtn\ntc.set_backend('jax')\nn=32; nl=2; max_steps=5000; lr=0.02; npar=465\nwith open('/tmp/psi.pkl','rb') as f: psi=pickle.load(f)\ndef convert_quimb(psi):\n arrs=psi.tensors; n=len(arrs); out=[]\n for i,t in enumerate(arrs):\n  a=np.asarray(t.data)\n  if i==0: b=jnp.asarray(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64)\n  elif i==n-1: b=jnp.asarray(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64)\n  else: b=jnp.asarray(a.transpose(0,2,1),dtype=jnp.complex64)\n  out.append(b)\n return out\ntt=convert_quimb(psi)\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\ndef apply(theta):\n c=tc.MPSCircuit(n,tensors=neel,center_position=0)\n gidx=0\n for layer in range(nl):\n  bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n  for b in bonds:\n   p=theta[gidx*15:(gidx+1)*15]\n   c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1)\n   gidx+=1\n return c\ndef make_t(): return tc.MPSCircuit(n,tensors=tt,center_position=0)\ndef loss(theta):\n c=apply(theta); t=make_t()\n ov=c.proj_with_mps(t,conj=True)\n f=jnp.real(ov*jnp.conj(ov))\n return 1.0-f\nvg=jax.jit(jax.value_and_grad(loss))\nkey=jax.random.PRNGKey(2039)\ntheta=jax.random.normal(key,(npar,),dtype=jnp.float32)*0.02\nopt=optax.adam(lr)\nopt_state=opt.init(theta)\nlosses=np.empty(max_steps,dtype=np.float64)\nfids=np.empty(max_steps,dtype=np.float64)\nt0=time.time()\nfor step in range(max_steps):\n v,g=vg(theta)\n vn=np.asarray(v); losses[step]=vn; fids[step]=1.0-vn\n updates,opt_state=opt.update(g,opt_state,theta)\n theta=optax.apply_updates(theta,updates)\n if step%1000==0:\n  jax.block_until_ready(v)\n  print(step,'loss',vn,'fid',fids[step],'gnorm',np.linalg.norm(np.asarray(g)))\nprint('train time',time.time()-t0)\nprint('final after last',losses[-1],fids[-1])\nprint('initial',fids[0], 'max',fids.max(), 'last10', fids[-10:])\n# compute actual final fidelity after last update\nv=loss(theta); print('actual final loss/fid',v,1-float(v))\nPY\npython /tmp/train_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
