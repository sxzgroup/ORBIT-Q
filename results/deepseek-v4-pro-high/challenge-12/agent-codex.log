{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench3.py <<'PY'\nimport os,time,pickle\nimport jax, jax.numpy as jnp\nimport numpy as np\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nimport quimb.tensor as qtn\ntc.set_backend('jax')\nprint('backend',tc.backend.name,'dtype',tc.dtypestr)\n\nwith open('/tmp/psi.pkl','rb') as f: psi=pickle.load(f)\nn=32; nl=2; npar=31*15\nprint('npar',npar,'bond sizes',psi.bond_sizes())\n\ndef convert_quimb(psi):\n ts=[]\n arrs=psi.tensors\n for i,t in enumerate(arrs):\n  a=np.asarray(t.data)\n  if i==0:\n   b=jnp.asarray(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64)\n  elif i==n-1:\n   b=jnp.asarray(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64)\n  else:\n   b=jnp.asarray(a.transpose(0,2,1),dtype=jnp.complex64)\n  ts.append(b)\n return ts\ntt=convert_quimb(psi)\nprint('shapes',[t.shape for t in tt[:3]], tt[-1].shape)\n\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\n\ndef apply(theta):\n c=tc.MPSCircuit(n,tensors=neel,center_position=0)\n for layer in range(nl):\n  bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n  for b in bonds:\n   p=theta[(layer*(n-1)+b)*15:(layer*(n-1)+b+1)*15]\n   c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1)\n return c\n\ndef make_t():\n return tc.MPSCircuit(n,tensors=tt,center_position=0)\n\ndef loss(theta):\n c=apply(theta); t=make_t()\n ov=c.proj_with_mps(t,conj=True)\n f=jnp.real(ov*jnp.conj(ov))\n return 1.0-f, ov\n# eager loss and initial fidelity\nkey=jax.random.PRNGKey(0)\ntheta=jax.random.normal(key,(npar,),dtype=jnp.float32)*0.02\n# Use a lambda returning loss only for grad\nlossval=lambda th: loss(th)[0]\nt0=time.time(); print('loss,ov',loss(theta)); print('eager',time.time()-t0)\nprint('compile value_and_grad')\nvg=jax.jit(jax.value_and_grad(lossval))\nt0=time.time(); v,g=vg(theta); print('v',v,'gnorm',jnp.linalg.norm(g)); print('compile+first',time.time()-t0)\nvg.clear_cache()\nt0=time.time(); v,g=vg(theta); print('second value+grad',time.time()-t0)\n# repeat\nfor _ in range(2):\n t0=time.time(); v,g=vg(theta); print('per',time.time()-t0)\nPY\npython /tmp/bench3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
