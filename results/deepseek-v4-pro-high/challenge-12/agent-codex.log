27142334 final 0.2754862904548645\nlr 0.05 best 0.2756781578063965 final 0.2754631042480469\nlr 0.1 best 0.275671124458313 final 0.27541446685791016\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/small_global.py <<'PY'\n# compare local optima for small n with many random starts and chi truncation\nimport quimb,quimb.tensor as qtn,numpy as np,time,pickle,os\nimport jax,jax.numpy as jnp\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nimport scipy.optimize as opt\ntc.set_backend('jax')\nfor n in [6,8,10]:\n # build target\n mpo=qtn.MPO_ham_heis(n,j=(4,4,5.6),S=1/2,cyclic=False)\n field=qtn.MPO_product_operator([0.2*((-1)**i)*quimb.pauli('Z',sparse=True).toarray() for i in range(n)])\n H=mpo+field\n p0=qtn.MPS_neel_state(n)\n dm=qtn.DMRG1(H,p0=p0,bond_dims=[8]*n,cutoffs=1e-10); dm.solve(max_sweeps=4,tol=1e-7,verbosity=0)\n psi=dm.state\n # truncation fidelity chi4\n psi4=psi.copy(); psi4.compress(max_bond=4,cutoff=0); ftr=abs(psi.H@psi4)**2\n # convert\n out=[]\n for i,t in enumerate(psi.tensors):\n  a=np.asarray(t.data)\n  if i==0: out.append(jnp.asarray(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64))\n  elif i==n-1: out.append(jnp.asarray(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64))\n  else: out.append(jnp.asarray(a.transpose(0,2,1),dtype=jnp.complex64))\n tt=out\n neel=[]\n for i in range(n):\n  v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n  neel.append(v[None,:,None])\n npar=(n-1)*15\n def apply(theta):\n  c=tc.MPSCircuit(n,tensors=neel,center_position=0);gidx=0\n  for layer in range(2):\n   bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n   for b in bonds:\n    p=theta[gidx*15:(gidx+1)*15]; c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1); gidx+=1\n  return c\n def loss(theta):\n  c=apply(theta);t=tc.MPSCircuit(n,tensors=tt,center_position=0);ov=c.proj_with_mps(t,conj=True);return 1-jnp.real(ov*jnp.conj(ov))\n vg=jax.jit(jax.value_and_grad(loss))\n def fun(x):\n  v,g=vg(jnp.asarray(x,dtype=jnp.float32));jax.block_until_ready(v);jax.block_until_ready(g);return float(np.asarray(v)),np.asarray(g,dtype=np.float64)\n best=0\n for seed in range(20):\n  key=jax.random.PRNGKey(seed);x0=np.asarray(jax.random.normal(key,(npar,),dtype=jnp.float32)*0.02,dtype=np.float64)\n  res=opt.minimize(fun,x0,method='L-BFGS-B',jac=True,options={'maxiter':200,'ftol':1e-9,'gtol':1e-6})\n  best=max(best,1-res.fun)\n print('n',n,'trunc fid',ftr,'best local',best)\nPY\npython /tmp/small_global.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
