{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/kak_train.py <<'PY'\nimport os,time,pickle\nimport jax,jax.numpy as jnp,numpy as np,optax\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nimport quimb.tensor as qtn\ntc.set_backend('jax')\nn=32\nwith open('/tmp/psi.pkl','rb') as f: psi=pickle.load(f)\ndef conv(psi):\n out=[]\n for i,t in enumerate(psi.tensors):\n  a=np.asarray(t.data)\n  if i==0: out.append(jnp.asarray(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64))\n  elif i==n-1: out.append(jnp.asarray(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64))\n  else: out.append(jnp.asarray(a.transpose(0,2,1),dtype=jnp.complex64))\n return out\ntt=conv(psi)\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\n\nX=jnp.array([[0,1],[1,0]],dtype=jnp.complex64)\nY=jnp.array([[0,-1j],[1j,0]],dtype=jnp.complex64)\nZ=jnp.array([[1,0],[0,-1]],dtype=jnp.complex64)\nI=jnp.eye(2,dtype=jnp.complex64)\nXX=jnp.kron(X,X); YY=jnp.kron(Y,Y); ZZ=jnp.kron(Z,Z)\n\ndef su2(p):\n a,b,c=p[0],p[1],p[2]\n # Rz(a) Ry(b) Rz(c)\n Rz=lambda t: jnp.array([[jnp.exp(-0.5j*t),0],[0,jnp.exp(0.5j*t)]],dtype=jnp.complex64)\n Ry=lambda t: jnp.array([[jnp.cos(t/2),-jnp.sin(t/2)],[jnp.sin(t/2),jnp.cos(t/2)]],dtype=jnp.complex64)\n return Rz(a) @ Ry(b) @ Rz(c)\n\ndef kak_gate(p):\n # p length 15: 6+6+3\n L1=su2(p[0:3]); L2=su2(p[3:6]); R1=su2(p[6:9]); R2=su2(p[9:12])\n tx,ty,tz=p[12],p[13],p[14]\n Uc=(jnp.cos(tx)*jnp.eye(4,dtype=jnp.complex64)+1j*jnp.sin(tx)*XX)@(jnp.cos(ty)*jnp.eye(4,dtype=jnp.complex64)+1j*jnp.sin(ty)*YY)@(jnp.cos(tz)*jnp.eye(4,dtype=jnp.complex64)+1j*jnp.sin(tz)*ZZ)\n U=jnp.kron(L1,L2) @ Uc @ jnp.kron(R1,R2)\n return U.reshape(2,2,2,2)\n\ndef apply(theta):\n c=tc.MPSCircuit(n,tensors=neel,center_position=0);gidx=0\n for layer in range(2):\n  bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n  for b in bonds:\n   p=theta[gidx*15:(gidx+1)*15]\n   c.apply_adjacent_double_gate(gates.Gate(kak_gate(p)),b,b+1); gidx+=1\n return c\ndef loss(theta):\n c=apply(theta);t=tc.MPSCircuit(n,tensors=tt,center_position=0);ov=c.proj_with_mps(t,conj=True);return 1-jnp.real(ov*jnp.conj(ov))\n# unitarity test at random\nkey=jax.random.PRNGKey(0); p=jax.random.normal(key,(15,),dtype=jnp.float32)*0.1\ng=kak_gate(p); m=g.reshape(4,4); print('unitarity err',jnp.max(jnp.abs(m.conj().T@m-jnp.eye(4,dtype=jnp.complex64))))\nvg=jax.jit(jax.value_and_grad(loss)); theta=jax.random.normal(jax.random.PRNGKey(2039),(465,),dtype=jnp.float32)*0.02\nprint('initial',loss(theta)); print('grad',jax.grad(loss)(theta)[:5])\nopt=optax.adam(0.02);state=opt.init(theta);best=0\nt0=time.time()\nfor step in range(5000):\n v,g=vg(theta); f=1-float(np.asarray(v)); best=max(best,f)\n updates,state=opt.update(g,state,theta); theta=optax.apply_updates(theta,updates)\n if step%1000==0:\n  jax.block_until_ready(v); print(step,f, 'gnorm',float(np.linalg.norm(np.asarray(g))))\n if step==4999: jax.block_until_ready(v)\nprint('time',time.time()-t0,'best',best,'final',1-float(np.asarray(v)))\nPY\npython /tmp/kak_train.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
