{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bh_n8.py <<'PY'\n# basinhopping for n=8, maybe find better\nimport quimb,quimb.tensor as qtn,numpy as np,time\nimport jax,jax.numpy as jnp\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nfrom scipy.optimize import basinhopping,minimize\ntc.set_backend('jax')\nn=8\nmpo=qtn.MPO_ham_heis(n,j=(4,4,5.6),S=1/2,cyclic=False);field=qtn.MPO_product_operator([0.2*((-1)**i)*quimb.pauli('Z',sparse=True).toarray() for i in range(n)]);H=mpo+field\ndm=qtn.DMRG1(H,p0=qtn.MPS_neel_state(n),bond_dims=[8]*n,cutoffs=1e-10);dm.solve(max_sweeps=4,tol=1e-7,verbosity=0);psi=dm.state\ntt=[]\nfor i,t in enumerate(psi.tensors):\n a=np.asarray(t.data)\n if i==0:tt.append(jnp.asarray(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64))\n elif i==n-1:tt.append(jnp.asarray(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64))\n else:tt.append(jnp.asarray(a.transpose(0,2,1),dtype=jnp.complex64))\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\nnpar=(n-1)*15\ndef apply(theta):\n c=tc.MPSCircuit(n,tensors=neel,center_position=0);gidx=0\n for layer in range(2):\n  bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n  for b in bonds:\n   p=theta[gidx*15:(gidx+1)*15]; c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1);gidx+=1\n return c\ndef loss(theta):\n c=apply(theta);t=tc.MPSCircuit(n,tensors=tt,center_position=0);ov=c.proj_with_mps(t,conj=True);return 1-jnp.real(ov*jnp.conj(ov))\nvg=jax.jit(jax.value_and_grad(loss))\ndef fun(x):\n v,g=vg(jnp.asarray(x,dtype=jnp.float32));jax.block_until_ready(v);jax.block_until_ready(g);return float(np.asarray(v)),np.asarray(g,dtype=np.float64)\nkey=jax.random.PRNGKey(0);x0=np.asarray(jax.random.normal(key,(npar,),dtype=jnp.float32)*0.02,dtype=np.float64)\nminkw={'method':'L-BFGS-B','jac':True,'options':{'maxiter':100,'ftol':1e-9,