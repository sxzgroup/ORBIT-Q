{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\ntc.set_backend('jax')\nn=4; nl=2; npar=6*15\n\ndef rand_mps(key,n=4,chi=3):\n ts=[]; l=1\n for i in range(n):\n  r=1 if i==n-1 else chi\n  key,s=jax.random.split(key)\n  a=jax.random.normal(s,(l,2,r),dtype=jnp.float32)+1j*jax.random.normal(s,(l,2,r),dtype=jnp.float32)\n  # normalize full MPS using transfer maybe skip, but make each tensor unit-ish? normalize vector globally\n  ts.append(a)\n  l=r\n return ts\n\n# normalize by full contraction\ndef norm_mps(ts):\n  # simple brute state via tensor contraction\n  A=ts[0][0,:,0]  # phys vector\n  for t in ts[1:]:\n    A=jnp.einsum('...a,ab->...b',A,t[:, :, 0] if t.shape[-1]==1 else t)\n  return jnp.sqrt(jnp.sum(jnp.abs(A)**2))\n\nkey=jax.random.PRNGKey(1)\ntt=rand_mps(key)\n# Normalize each? Let's normalize via direct full amplitude contraction correctly\n# full tensor contraction shape (2\"'^n). For n=4 easy\ndef full(ts):\n A=ts[0][0,:,0] # [2]\n for t in ts[1:]:\n  # A shape [dims..., left], t shape [left, phys, right]. right always 1 for last? but internal right chi, need contract and expand\n  # do sequential from left with right bond not 1: A has right bond l, t has left l, phys, right r.\n  A=jnp.einsum('\"'...l,lpr->...pr',A,t)\n  # move p to ... and keep r as last\n A=jnp.reshape(A,(2,)*n)\n return A\nA=full(tt)\ntt=[t/jnp.sqrt(jnp.sum(jnp.abs(A)**2)) for t in tt]\nprint('norm',jnp.linalg.norm(full(tt)))\n# neel target? random\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\ndef apply(theta):\n c=tc.MPSCircuit(n,tensors=neel,center_position=0)\n for layer in range(2):\n  bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n  for b in bonds:\n   p=theta[(layer*(n-1)+b)*15:(layer*(n-1)+b+1)*15]\n   c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1)\n return c\ndef loss(theta):\n c=apply(theta); t=tc.MPSCircuit(n,tensors=tt,center_position=0)\n ov=c.proj_with_mps(t,conj=True)\n f=jnp.real(ov*jnp.conj(ov))\n return 1-f\nkey,s=jax.random.split(key)\ntheta=jax.random.normal(s,(npar,),dtype=jnp.float32)*0.1\nprint('loss',loss(theta))\ng=jax.grad(loss)(theta)\nprint('grad nonzero count',jnp.count_nonzero(g), 'norm',jnp.linalg.norm(g))\nprint(g[:20])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
