{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench.py <<'PY'\nimport os, time\n# no x64\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\ntc.set_backend('jax')\nprint('backend',tc.backend.name,'dtype',tc.dtypestr)\n\nn=32; n_layers=2; ngates=(n-1)*n_layers; npar=ngates*15\nprint(npar)\n\n# random target MPS arrays chi=8, shape left,phys,right\ndef random_target_mps(n, chi, key):\n    tensors=[]\n    left=1\n    for i in range(n):\n      right=1 if i==n-1 else chi\n      if i==0:\n        shape=(left,2,right)\n      elif i==n-1:\n        shape=(left,2,right)\n      else:\n        shape=(left,2,right)\n      # but left/right dims should match; simplify all internal chi\n      l=1 if i==0 else chi\n      r=1 if i==n-1 else chi\n      # fix shapes\n      key, sub = jax.random.split(key)\n      # actual left bond from previous right\n      if i==0:\n        l=1; r=chi\n      elif i==n-1:\n        l=chi; r=1\n      else:\n        l=chi; r=chi\n      arr=jax.random.normal(sub,(l,2,r),dtype=jnp.float32)+1j*jax.random.normal(sub,(l,2,r),dtype=jnp.float32)\n      arr=arr/jnp.linalg.norm(arr)\n      tensors.append(arr)\n    # NOTE not normalized globally; irrelevant for timing\n    return tensors\n\nkey=jax.random.PRNGKey(0)\ntarget_tensors=random_target_mps(n,8,key)\n# initialize target MPSCircuit with canonicalize False center 0\ndef make_target(tensors):\n    return tc.MPSCircuit(n, tensors=tensors, center_position=0)\n\n# neel initial tensors\ndef neel_tensors():\n    ts=[]\n    for i in range(n):\n      v=jnp.array([0.0,1.0],dtype=jnp.float32) if i%2==1 else jnp.array([1.0,0.0],dtype=jnp.float32)\n      ts.append(v[None,:,None])\n    return ts\nneel=neel_tensors()\n\ndef apply_circuit(theta):\n    c=tc.MPSCircuit(n, tensors=neel, center_position=0)\n    for layer in range(n_layers):\n      bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n      for b in bonds:\n        p=theta[(layer*(n-1)+b)*15:(layer*(n-1)+b+1)*15]\n        g=gates.su4_gate(p)\n        c.apply_adjacent_double_gate(g,b,b+1)\n    return c\n\ndef loss(theta):\n    c=apply_circuit(theta)\n    t=make_target(target_tensors)\n    ov=c.proj_with_mps(t,conj=True)\n    f=jnp.real(ov*jnp.conj(ov))\n    return 1.0-f\n\nkey,jax.random.split(key)\ntheta=jax.random.normal(key,(npar,),dtype=jnp.float32)*0.02\n\n# compile loss (and maybe grad)\nprint('starting loss')\nt=time.time()\nprint(loss(theta), 'time',time.time()-t)\nprint('compiling jit loss')\njloss=jax.jit(loss)\nt=time.time(); print(jloss(theta)); print('jit time',time.time()-t)\nprint('grad eager')\nt=time.time(); print(jax.grad(loss)(theta)[:5]); print('time',time.time()-t)\nprint('compiling jit grad')\njgrad=jax.jit(jax.grad(loss))\nt=time.time(); g=jgrad(theta); print(g[:5]); print('jit grad time',time.time()-t)\nPY\npython /tmp/bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
