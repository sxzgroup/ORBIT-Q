{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/gen_target.py <<'PY'\nimport quimb, quimb.tensor as qtn, numpy as np, time, pickle\nn=32; jxy=4; jz=5.6; h=0.2\nmpo=qtn.MPO_ham_heis(n,j=(jxy,jxy,jz),S=1/2,cyclic=False)\narrays=[0.2*((-1)**i)*quimb.pauli('Z',sparse=True).toarray() for i in range(n)]\nfield=qtn.MPO_product_operator(arrays)\nH=mpo+field\nprint('H maxbond',H.max_bond(), 'type',type(H))\np0=qtn.MPS_neel_state(n)\nprint('p0 shapes',[t.shape for t in p0.tensors])\ndm=qtn.DMRG1(H, p0=p0, bond_dims=[8]*n, cutoffs=1e-10)\nt=time.time(); dm.solve(max_sweeps=4, tol=1e-7, verbosity=0); print('time',time.time()-t)\npsi=dm.state\nprint('energy',dm.energy)\nprint('norm',psi.H@psi)\nprint('bond sizes',psi.bond_sizes())\nprint('shapes first/last',[a.shape for a in psi.tensors[:3]],[a.shape for a in psi.tensors[-3:]])\n# overlap with neel product via quimb dense? n32 impossible, but maybe use tensor contraction\n# use qtn.compute_local_expectation? skip\nwith open('/tmp/psi.pkl','wb') as f: pickle.dump(psi,f)\nPY\npython /tmp/gen_target.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
