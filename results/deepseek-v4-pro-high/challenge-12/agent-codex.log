{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport quimb, quimb.tensor as qtn, numpy as np, pickle, time\n# load target\nwith open('/tmp/psi.pkl','rb') as f: psi=pickle.load(f)\nn=32\nmpo=qtn.MPO_ham_heis(n,j=(4,4,5.6),S=1/2,cyclic=False)\narrays=[0.2*((-1)**i)*quimb.pauli('Z',sparse=True).toarray() for i in range(n)]\nfield=qtn.MPO_product_operator(arrays); H=mpo+field\nfor chi in [2,3,4,5,6,8]:\n p0=qtn.MPS_neel_state(n)\n dm=qtn.DMRG1(H,p0=p0,bond_dims=[chi]*n,cutoffs=1e-10)\n dm.solve(max_sweeps=4,tol=1e-7,verbosity=0)\n phi=dm.state\n # compute fidelity |<psi|phi>|\"'^2 using quimb tensor contraction\n # quimb has fidelity_mps? search\n import quimb.tensor as qt\n val=abs(psi.H @ phi)**2\n print(chi,'\"'energy',dm.energy,'fid',val,'bonds',phi.bond_sizes()[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
