{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/clip_test.py <<'PY'\n# test clipped adam variants quickly\nimport os,time,pickle\nimport jax,jax.numpy as jnp,numpy as np,optax\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nimport quimb.tensor as qtn\ntc.set_backend('jax')\nn=32\nwith open('/tmp/psi.pkl','rb') as f: psi=pickle.load(f)\ndef conv(psi):\n out=[]\n for i,t in enumerate(psi.tensors):\n  a=np.asarray(t.data)\n  if i==0: out.append(jnp.asarray(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64))\n  elif i==n-1: out.append(jnp.asarray(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64))\n  else: out.append(jnp.asarray(a.transpose(0,2,1),dtype=jnp.complex64))\n return out\ntt=conv(psi)\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\ndef apply(theta):\n c=tc.MPSCircuit(n,tensors=neel,center_position=0);gidx=0\n for layer in range(2):\n  bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n  for b in bonds:\n   p=theta[gidx*15:(gidx+1)*15]; c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1); gidx+=1\n return c\ndef loss(theta):\n c=apply(theta);t=tc.MPSCircuit(n,tensors=tt,center_position=0);ov=c.proj_with_mps(t,conj=True);return 1-jnp.real(ov*jnp.conj(ov))\nvg=jax.jit(jax.value_and_grad(loss))\nfor clip in [0.01,0.05,0.1,0.5,1.0,2.0]:\n key=jax.random.PRNGKey(2039);theta=jax.random.normal(key,(465,),dtype=jnp.float32)*0.02\n opt=optax.chain(optax.clip_by_global_norm(clip),optax.adam(0.02)); state=opt.init(theta)\n best=0\n for step in range(5000):\n  v,g=vg(theta);f=1-float(np.asarray(v));best=max(best,f)\n  updates,state=opt.update(g,state,theta);theta=optax.apply_updates(theta,updates)\n  if step==4999:jax.block_until_ready(v)\n print('clip',clip,'best',best,'final',1-float(np.asarray(v)))\nPY\npython /tmp/clip_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
