{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench2.py <<'PY'\nimport os, time\nimport jax, jax.numpy as jnp\nimport numpy as np\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\nimport quimb.tensor as qtn\ntc.set_backend('jax')\nprint('backend',tc.backend.name,'dtype',tc.dtypestr)\n\nn=32; n_layers=2; ngates=(n-1)*n_layers; npar=ngates*15\nprint('npar',npar)\n\ndef convert_quimb(psi):\n    ts=[]\n    for i,t in enumerate(psi.tensors):\n      a=t.data\n      # quimb open MPS physical last, boundary missing dummy bond\n      a=np.asarray(a)\n      if i==0:\n        # shape (right,phys)\n        b=jnp.array(a.reshape(1,a.shape[1],a.shape[0]),dtype=jnp.complex64)\n      elif i==len(psi.tensors)-1:\n        b=jnp.array(a.reshape(a.shape[0],a.shape[1],1),dtype=jnp.complex64)\n      else:\n        b=jnp.array(a.transpose(0,2,1),dtype=jnp.complex64)\n      ts.append(b)\n    return ts\n\npsi=qtn.MPS_rand_state(n,bond_dim=8,normalize=True,dtype='complex64',cyclic=False)\ntarget_tensors=convert_quimb(psi)\nprint('target bond dims first/last', [t.shape for t in target_tensors[:3]], target_tensors[-1].shape)\n\n# verify target norm via tc proj maybe\n# neel tensors\nneel=[]\nfor i in range(n):\n v=jnp.array([0,1],dtype=jnp.complex64) if i%2==1 else jnp.array([1,0],dtype=jnp.complex64)\n neel.append(v[None,:,None])\n\ndef apply_circuit(theta):\n    c=tc.MPSCircuit(n, tensors=neel, center_position=0)\n    for layer in range(n_layers):\n      bonds=range(0,n-1,2) if layer==0 else range(1,n-1,2)\n      for b in bonds:\n        p=theta[(layer*(n-1)+b)*15:(layer*(n-1)+b+1)*15]\n        c.apply_adjacent_double_gate(gates.su4_gate(p),b,b+1)\n    return c\n\ndef make_target():\n    return tc.MPSCircuit(n, tensors=target_tensors, center_position=0)\n\ndef loss(theta):\n    c=apply_circuit(theta)\n    t=make_target()\n    ov=c.proj_with_mps(t,conj=True)\n    f=jnp.real(ov*jnp.conj(ov))\n    return 1.0-f\n\n# target norm check\nt=make_target(); print('target norm?', t.get_norm())\n\nkey=jax.random.PRNGKey(0)\ntheta=jax.random.normal(key,(npar,),dtype=jnp.float32)*0.02\nprint('starting loss')\nt0=time.time(); print(loss(theta)); print('eager loss time',time.time()-t0)\nprint('compile grad')\ngrad=jax.jit(jax.grad(loss))\nt0=time.time(); g=grad(theta); print('g first',g[:10], 'norm',jnp.linalg.norm(g)); print('jit grad compile+first time',time.time()-t0)\n# benchmark iterations of jit grad after compile\ngrad.clear_cache()\n# one more to warm? already compiled\nt0=time.time()\nfor _ in range(3):\n g=grad(theta)\nprint('3 grad time',time.time()-t0, 'per',(time.time()-t0)/3)\nPY\npython /tmp/bench2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
