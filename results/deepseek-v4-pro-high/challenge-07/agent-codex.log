{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/diag_mvp.py <<'PY'\nimport numpy as np,jax,jax.numpy as jnp,tensorcircuit as tc\ntc.set_backend('jax'); b=tc.backend; n=8\nzz=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\nxx=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\nmvp=tc.quantum.PauliStringSum2MVP(zz+xx, [-1.]*7+[-1.05]*8)\nrng=np.random.default_rng(2047); sts=rng.uniform(size=(64,2,8)).astype(np.float32)\ndef get_ds(k):\n p=np.zeros((2,6,8),dtype=np.float32)\n c=tc.Circuit(16)\n for l in range(2):\n  for i in range(n): c.ry(i,theta=p[l,0,i])\n  for i in range(n): c.ry(8+i,theta=p[l,1,i])\n  for i in range(n): c.rzz(8+i,i,theta=p[l,2,i])\n  for j in range(8,15): c.cnot(j,j+1)\n  for i in range(n):\n   r=c.cond_measurement(8+i,status=float(sts[k,l,i])); c.conditional_gate(r,[tc.gates.rzz_gate(theta=p[l,3,i]),tc.gates.rzz_gate(theta=p[l,4,i])],8+i,i)\n  for j in range(7): c.cnot(j,j+1)\n  for i in range(n): c.rz(i,theta=p[l,5,i])\n s=b.reshape(c.state(),[2]*16)\n ds=tc.quantum.reduced_wavefunction(s,subsystem_to_keep=list(range(n))); return b.reshape(ds,[-1])\nfor k in [30,57,0]:\n ds=get_ds(k); ds=ds/b.norm(ds)\n hp=mvp(ds)\n print(k,'ds norm',float(b.norm(ds)),'hp norm',float(b.norm(hp)),'hp nan',np.any(np.isnan(np.asarray(hp))),'dot',np.asarray(b.sum(b.conj(ds)*hp)))\n print('ds sample',np.asarray(ds)[:5],'hp sample',np.asarray(hp)[:5])\nPY\npython /tmp/diag_mvp.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
