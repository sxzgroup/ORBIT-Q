{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/diag_nan2.py <<'PY'\nimport numpy as np,jax,jax.numpy as jnp,tensorcircuit as tc\ntc.set_backend('jax'); b=tc.backend; n=8\nzz=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\nxx=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\nmvp=tc.quantum.PauliStringSum2MVP(zz+xx, [-1.]*7+[-1.05]*8)\nrng=np.random.default_rng(2047); sts=jnp.asarray(rng.uniform(size=(64,2,8)),dtype=jnp.float32)\nkey=jax.random.PRNGKey(0); p=jax.random.normal(key,[2,6,8],dtype=jnp.float32)*0.1\n\ndef analyze(k):\n c=tc.Circuit(16)\n for l in range(2):\n  for i in range(n): c.ry(i,theta=p[l,0,i])\n  for i in range(n): c.ry(8+i,theta=p[l,1,i])\n  for i in range(n): c.rzz(8+i,i,theta=p[l,2,i])\n  for j in range(8,15): c.cnot(j,j+1)\n  for i in range(n):\n   r=c.cond_measurement(8+i,status=sts[k,l,i]); c.conditional_gate(r,[tc.gates.rzz_gate(theta=p[l,3,i]),tc.gates.rzz_gate(theta=p[l,4,i])],8+i,i)\n  for j in range(7): c.cnot(j,j+1)\n  for i in range(n): c.rz(i,theta=p[l,5,i])\n st=c.state(); fullnorm=b.norm(st)\n s=b.reshape(st,[2]*16); ds=tc.quantum.reduced_wavefunction(s,subsystem_to_keep=list(range(n))); ds=b.reshape(ds,[-1]); dsnorm=b.norm(ds); ds=ds/dsnorm\n hp=mvp(ds)\n print('k',k,'full',float(fullnorm),'ds',float(dsnorm),'hp norm',float(b.norm(hp)),'hp nan',bool(jnp.any(jnp.isnan(hp))),'dot',complex(b.sum(b.conj(ds)*hp)))\nfor k in [30,57,0,1]:\n analyze(k)\nPY\npython /tmp/diag_nan2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
