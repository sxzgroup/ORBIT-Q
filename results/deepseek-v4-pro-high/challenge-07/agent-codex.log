{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\n# quick test status tensor vs float for k30\nimport numpy as np,jax,jax.numpy as jnp,tensorcircuit as tc\ntc.set_backend('jax'); b=tc.backend; n=8\nzz=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\nxx=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\nmvp=tc.quantum.PauliStringSum2MVP(zz+xx, [-1.]*7+[-1.05]*8)\ndef state(params,status_as_float=False):\n c=tc.Circuit(16)\n for l in range(2):\n  for i in range(n): c.ry(i,theta=params[l,0,i])\n  for i in range(n): c.ry(8+i,theta=params[l,1,i])\n  for i in range(n): c.rzz(8+i,i,theta=params[l,2,i])\n  for j in range(8,15): c.cnot(j,j+1)\n  for i in range(n):\n   s=params[l,i] if False else None\n   status=float(status_arr[l,i]) if status_as_float else status_arr[l,i]\n   r=c.cond_measurement(8+i,status=status)\n   c.conditional_gate(r,[tc.gates.rzz_gate(theta=params[l,3,i]),tc.gates.rzz_gate(theta=params[l,4,i])],8+i,i)\n  for j in range(7): c.cnot(j,j+1)\n  for i in range(n): c.rz(i,theta=params[l,5,i])\n return c.state()\ndef ef(st):\n s=b.reshape(st,[2]*16); ds=tc.quantum.reduced_wavefunction(s,subsystem_to_keep=list(range(n))); ds=b.reshape(ds,[-1]); ds=ds/b.norm(ds); hp=mvp(ds); return b.real(b.sum(b.conj(ds)*hp))\nrng=np.random.default_rng(2047); sts=rng.uniform(size=(64,2,8)).astype(np.float32)\np=jnp.zeros((2,6,8),dtype=jnp.float32)\nfor k in [30,57]:\n status_arr=jnp.asarray(sts[k])\n print('k',k,'tensor',ef(state(p,False)),'float',ef(state(p,True)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
