{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/test_opt.py <<'PY'\nimport time, numpy as np\nimport jax, jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\ntc.set_backend('jax')\nbackend=tc.backend\nn=8\nL=2\n\ndef make_mvp():\n    zz_structs=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\n    x_structs=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\n    return tc.quantum.PauliStringSum2MVP(zz_structs+x_structs, [-1.0]*7+[-1.05]*8)\nmvp=make_mvp()\n\ndef energy_from_state(st):\n    s=backend.reshape(st,[2]*16)\n    ds=tc.quantum.reduced_wavefunction(s, subsystem_to_keep=list(range(n)))\n    ds=backend.reshape(ds,[-1])\n    norm=backend.norm(ds)\n    ds=ds/norm\n    hp=mvp(ds)\n    return backend.real(backend.sum(backend.conj(ds)*hp))\n\ndef circuit_state(params, status):\n    c=tc.Circuit(16)\n    for l in range(2):\n        for i in range(n): c.ry(i, theta=params[l,0,i])\n        for i in range(n): c.ry(8+i, theta=params[l,1,i])\n        for i in range(n): c.rzz(8+i,i, theta=params[l,2,i])\n        for j in range(8,15): c.cnot(j,j+1)\n        for i in range(n):\n            r=c.cond_measurement(8+i, status=status[l,i])\n            c.conditional_gate(r, [tc.gates.rzz_gate(theta=params[l,3,i]), tc.gates.rzz_gate(theta=params[l,4,i])], 8+i, i)\n        for j in range(7): c.cnot(j,j+1)\n        for i in range(n): c.rz(i, theta=params[l,5,i])\n    return c.state()\n\ndef one_energy(params,status):\n    return energy_from_state(circuit_state(params,status))\n\ndef objective(params,statuses):\n    es=jax.vmap(one_energy,in_axes=(None,0))(params,statuses)\n    return jnp.mean(es)\n\nif __name__=='__main__':\n    seed=2047\n    rng=np.random.default_rng(seed)\n    params=np.asarray(rng.normal(0,0.1,size=(2,6,8)),dtype=np.float32)\n    statuses=np.asarray(rng.uniform(size=(64,2,8)),dtype=np.float32)\n    jparams=jnp.asarray(params)\n    val_grad=jax.jit(jax.value_and_grad(objective))\n    t0=time.time()\n    v,g=val_grad(jparams,jnp.asarray(statuses))\n    print('first val grad time',time.time()-t0,'v',float(v),'g norm',float(jnp.linalg.norm(g)))\n    opt=optax.adam(0.02)\n    opt_state=opt.init(jparams)\n    history=[]\n    times=[]\n    for step in range(100):\n        t=time.time()\n        v,g=val_grad(jparams,jnp.asarray(statuses))\n        updates,opt_state=opt.update(g,opt_state)\n        jparams=optax.apply_updates(jparams,updates)\n        history.append(float(v))\n        times.append(time.time()-t)\n        if step%10==0 or step==99:\n            print(step,'v',history[-1],'step time',times[-1])\n    print('total',sum(times),'max',max(times),'mean',np.mean(times))\n    print('final energies via vmap jit')\n    ef=jax.jit(jax.vmap(one_energy,in_axes=(None,0)))\n    es=ef(jparams,jnp.asarray(statuses))\n    print(es[:5], np.mean(np.asarray(es)))\nPY\npython /tmp/test_opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
