{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/test_nan.py <<'PY'\nimport time,numpy as np,jax,jax.numpy as jnp,tensorcircuit as tc\ntc.set_backend('jax'); b=tc.backend; n=8\nzz=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\nxx=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\nmvp=tc.quantum.PauliStringSum2MVP(zz+xx, [-1.]*7+[-1.05]*8)\ndef ef(st):\n s=b.reshape(st,[2]*16); ds=tc.quantum.reduced_wavefunction(s,subsystem_to_keep=list(range(n))); ds=b.reshape(ds,[-1]); nm=b.norm(ds); ds=ds/nm; hp=mvp(ds); return b.real(b.sum(b.conj(ds)*hp))\ndef state(params,status):\n c=tc.Circuit(16)\n for l in range(2):\n  for i in range(n): c.ry(i,theta=params[l,0,i])\n  for i in range(n): c.ry(8+i,theta=params[l,1,i])\n  for i in range(n): c.rzz(8+i,i,theta=params[l,2,i])\n  for j in range(8,15): c.cnot(j,j+1)\n  for i in range(n):\n   r=c.cond_measurement(8+i,status=status[l,i]); c.conditional_gate(r,[tc.gates.rzz_gate(theta=params[l,3,i]),tc.gates.rzz_gate(theta=params[l,4,i])],8+i,i)\n  for j in range(7): c.cnot(j,j+1)\n  for i in range(n): c.rz(i,theta=params[l,5,i])\n return c.state()\ndef oe(params,status): return ef(state(params,status))\nkey=jax.random.PRNGKey(0); p=jax.random.normal(key,[2,6,8])*.1\nrng=np.random.default_rng(2047); sts=jnp.asarray(rng.uniform(size=(64,2,8)),dtype=jnp.float32)\n# compute energies non-batched eager for first few\nvals=[]\nfor k in range(64):\n e=oe(p,sts[k]); vals.append(float(e)); print(k,e, 'nan?',np.isnan(e))\nprint('finite',sum(np.isfinite(vals)))\n# grad each maybe nan\nfor k in range(64):\n g=jax.grad(oe)(p,sts[k]); n=jnp.linalg.norm(g); \n if jnp.any(jnp.isnan(g)) or float(jnp.isnan(n)): print('nan grad k',k,'n',n)\nprint('done')\nPY\npython /tmp/test_nan.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
