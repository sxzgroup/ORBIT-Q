{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/test_energy.py <<'PY'\nimport time, numpy as np\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax')\nbackend=tc.backend\nn=8\n# data qubits original 0..7, anc 8..15\nmvp = tc.quantum.PauliStringSum2MVP(\n    [[3 if j==i else (3 if j==i+1 else 0) for j in range(n)] for i in range(7)] + [[1 if j==i else 0 for j in range(n)] for i in range(n)],\n    [-1.0]*7 + [-1.05]*8\n)\n# Actually structures for ZZ: [0,0,..3,3,..]\nzz_structs=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\nx_structs=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\nmvp=tc.quantum.PauliStringSum2MVP(zz_structs+x_structs, [-1.0]*7+[-1.05]*8)\n\ndef energy_from_state(st):\n    # st full 16-qubit state shape [2]*16 or flat? use reshape\n    s = backend.reshape(st, [2]*16)\n    # trace out ancillas original 8..15 => keep data 0..7\n    # reduced_wavefunction with subsystem_to_keep\n    data_state = tc.quantum.reduced_wavefunction(s, subsystem_to_keep=list(range(n)))\n    data_state = backend.reshape(data_state, [-1])\n    # normalize\n    norm = backend.norm(data_state)\n    data_state = data_state / norm\n    hpsi = mvp(data_state)\n    e = backend.real(backend.sum(backend.conj(data_state) * hpsi))\n    return e\n\ndef circuit_state(params, status):\n    c=tc.Circuit(16)\n    # params shape [2,6,8]? status [2,8]\n    for l in range(2):\n        for i in range(n):\n            c.ry(i, theta=params[l,0,i])\n        for i in range(n):\n            c.ry(8+i, theta=params[l,1,i])\n        for i in range(n):\n            c.rzz(8+i,i, theta=params[l,2,i])\n        for j in range(8,15):\n            c.cnot(j,j+1)\n        for i in range(n):\n            r=c.cond_measurement(8+i, status=status[l,i])\n            c.conditional_gate(r, [tc.gates.rzz_gate(theta=params[l,3,i]), tc.gates.rzz_gate(theta=params[l,4,i])], 8+i, i)\n        for j in range(7):\n            c.cnot(j,j+1)\n        for i in range(n):\n            c.rz(i, theta=params[l,5,i])\n    return c.state()\n\ndef one_energy(params, status):\n    return energy_from_state(circuit_state(params, status))\n\nif __name__=='__main__':\n    key=jax.random.PRNGKey(0)\n    params=jax.random.normal(key,[2,6,8],dtype=jnp.float32)*0.1\n    status=jax.random.uniform(key,[2,8],dtype=jnp.float32)\n    t0=time.time(); e=one_energy(params,status); print('eager e',e,'time',time.time()-t0)\n    grad=jax.grad(one_energy)(params,status)\n    print('grad shape',grad.shape,'time grad',time.time()-t0,'sum',jnp.sum(jnp.abs(grad)))\n    # jit single\n    j=jax.jit(one_energy)\n    t0=time.time(); e=j(params,status); print('jit compile+run',e,time.time()-t0)\n    t0=time.time(); e=j(params,status); print('jit run',e,time.time()-t0)\n    # vmap 4\n    statuses=jax.random.uniform(key,[4,2,8],dtype=jnp.float32)\n    v=jax.vmap(one_energy,in_axes=(None,0))\n    t0=time.time(); es=v(params,statuses); print('vmap eager',es,time.time()-t0)\n    vj=jax.jit(v)\n    t0=time.time(); es=vj(params,statuses); print('vmap jit compile',es,time.time()-t0)\n    t0=time.time(); es=vj(params,statuses); print('vmap jit run',es,time.time()-t0)\nPY\npython /tmp/test_energy.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
