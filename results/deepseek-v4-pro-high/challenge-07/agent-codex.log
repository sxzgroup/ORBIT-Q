ad(objective))\n    t0=time.time()\n    v,g=val_grad(jparams,jnp.asarray(statuses))\n    print('first val grad time',time.time()-t0,'v',float(v),'g norm',float(jnp.linalg.norm(g)))\n    opt=optax.adam(0.02)\n    opt_state=opt.init(jparams)\n    history=[]\n    times=[]\n    for step in range(100):\n        t=time.time()\n        v,g=val_grad(jparams,jnp.asarray(statuses))\n        updates,opt_state=opt.update(g,opt_state)\n        jparams=optax.apply_updates(jparams,updates)\n        history.append(float(v))\n        times.append(time.time()-t)\n        if step%10==0 or step==99:\n            print(step,'v',history[-1],'step time',times[-1])\n    print('total',sum(times),'max',max(times),'mean',np.mean(times))\n    print('final energies via vmap jit')\n    ef=jax.jit(jax.vmap(one_energy,in_axes=(None,0)))\n    es=ef(jparams,jnp.asarray(statuses))\n    print(es[:5], np.mean(np.asarray(es)))\nPY\npython /tmp/test_opt.py\"","aggregated_output":"first val grad time 36.42476987838745 v nan g norm nan\n0 v nan step time 0.5759105682373047\n10 v nan step time 0.5897479057312012\n20 v nan step time 0.6341478824615479\n30 v nan step time 0.534235954284668\n40 v nan step time 0.5370116233825684\n50 v nan step time 0.5282747745513916\n60 v nan step time 0.5289268493652344\n70 v nan step time 0.5264532566070557\n80 v nan step time 0.5518903732299805\n90 v nan step time 0.5217015743255615\n99 v nan step time 0.5375893115997314\ntotal 54.86277961730957 max 0.6767475605010986 mean 0.5486277961730956\nfinal energies via vmap jit\n[nan nan nan nan nan] nan\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -c \"python - <<'PY'\n# quick test jit grad single vs vmap grad\nimport time,numpy as np,jax,jax.numpy as jnp,tensorcircuit as tc\ntc.set_backend('jax'); b=tc.backend; n=8\nzz=[[3 if (j==i or j==i+1) else 0 for j in range(n)] for i in range(7)]\nxx=[[1 if j==i else 0 for j in range(n)] for i in range(n)]\nmvp=tc.quantum.PauliStringSum2MVP(zz+xx, [-1.]*7+[-1.05]*8)\ndef ef(st):\n s=b.reshape(st,[2]*16); ds=tc.quantum.reduced_wavefunction(s,subsystem_to_keep=list(range(n))); ds=b.reshape(ds,[-1]); ds=ds/b.norm(ds); hp=mvp(ds); return b.real(b.sum(b.conj(ds)*hp))\ndef state(params,status):\n c=tc.Circuit(16)\n for l in range(2):\n  for i in range(n): c.ry(i,theta=params[l,0,i])\n  for i in range(n): c.ry(8+i,theta=params[l,1,i])\n  for i in range(n): c.rzz(8+i,i,theta=params[l,2,i])\n  for j in range(8,15): c.cnot(j,j+1)\n  for i in range(n):\n   r=c.cond_measurement(8+i,status=status[l,i]); c.conditional_gate(r,[tc.gates.rzz_gate(theta=params[l,3,i]),tc.gates.rzz_gate(theta=params[l,4,i])],8+i,i)\n  for j in range(7): c.cnot(j,j+1)\n  for i in range(n): c.rz(i,theta=params[l,5,i])\n return c.state()\ndef oe(params,status): return ef(state(params,status))\nkey=jax.random.PRNGKey(0); p=jax.random.normal(key,[2,6,8])*.1; st=jax.random.uniform(key,[2,8])\nprint('eager',oe(p,st))\nfor f in [jax.jit(jax.grad(oe)), jax.grad(oe)]:\n try:\n  g=f(p,st); print(f, 'ok norm',jnp.linalg.norm(g), 'nan?',jnp.any(jnp.isnan(g)))\n except Exception as e: print('err',type(e),e)\n# vmap grad\nprint('vmap grad nonjit')\ntry:\n g=jax.vmap(jax.grad(oe),in_axes=(None,0))(p,jax.random.uniform(key,[4,2,8])); print(g.shape,jnp.any(jnp.isnan(g)))\nexcept Exception as e: print('err',type(e),e)\nprint('jit vmap grad')\ntry:\n f=jax.jit(jax.vmap(jax.grad(oe),in_axes=(None,0))); g=f(p,jax.random.uniform(key,[4,2,8])); print(g.shape,jnp.any(jnp.isnan(g)))\nexcept Exception as e: print('err',type(e),e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
