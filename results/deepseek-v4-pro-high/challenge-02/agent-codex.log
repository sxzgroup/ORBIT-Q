,\n42     )\n43     zz = jnp.diag(jnp.array([1, -1, -1, 1], dtype=jnp.complex64))\n44     def rotation(theta_y, theta_z):\n45         cy = jnp.cos(theta_y / 2)\n46         sy = jnp.sin(theta_y / 2)\n47         ry = jnp.array([[cy, -sy], [sy, cy]], dtype=jnp.complex64)\n48         phase = jnp.exp(-0.5j * theta_z)\n49         rz = jnp.diag(jnp.array([phase, jnp.conj(phase)], dtype=jnp.complex64))\n50         return rz @ ry\n51     def interaction(theta_x, theta_y, theta_z):\n52         ex = jnp.cos(theta_x) * eye4 - 1j * jnp.sin(theta_x) * xx\n53         ey = jnp.cos(theta_y) * eye4 - 1j * jnp.sin(theta_y) * yy\n54         ez = jnp.cos(theta_z) * eye4 - 1j * jnp.sin(theta_z) * zz\n55         return ex @ ey @ ez\n56     def apply_block(circuit, params):\n57         for q in range(n):\n58             circuit.any(q, unitary=rotation(params[2 * q], params[2 * q + 1]))\n59         for k, (i, j) in enumerate(even_bonds):\n60             circuit.any(\n61                 i,\n62                 j,\n63                 unitary=interaction(\n64                     params[24 + 3 * k],\n65                     params[24 + 3 * k + 1],\n66                     params[24 + 3 * k + 2],\n67                 ),\n68             )\n69         for q in range(n):\n70             circuit.any(\n71                 q, unitary=rotation(params[42 + 2 * q], params[42 + 2 * q + 1])\n72             )\n73         for k, (i, j) in enumerate(odd_bonds):\n74             circuit.any(\n75                 i,\n76                 j,\n77                 unitary=interaction(\n78                     params[66 + 3 * k],\n79                     params[66 + 3 * k + 1],\n80                     params[66 + 3 * k + 2],\n81                 ),\n82             )\n83     def entropy_of(state):\n84         rho = tc.quantum.reduced_density_matrix(\n85             state, subsystem_to_keep=list(range(sub))\n86         )\n87         return tc.quantum.renyi_entropy(rho, 2)\n88     def objective(params):\n89         circuit = tc.Circuit(n)\n90         for q in range(1, n, 2):\n91             circuit.x(q)\n92         apply_block(circuit, params[0:block_params])\n93         state1 = circuit.state()\n94         apply_block(circuit, params[block_params : 2 * block_params])\n95         state2 = circuit.state()\n96         apply_block(circuit, params[2 * block_params : 3 * block_params])\n97         state3 = circuit.state()\n98         entropies = jnp.stack(\n99             [entropy_of(state1), entropy_of(state2), entropy_of(state3)]\n100         )\n101         mse = jnp.mean((entropies - target) ** 2)\n102         energy_density = jnp.real(jnp.vdot(state3, hamiltonian @ state3)) / n\n103         return energy_density + weight * mse, (energy_density, mse, entropies)\n104     params = jnp.asarray(\n105         np.random.default_rng(12345).normal(0.0, 0.02, size=3 * block_params).astype(\n106             np.float32\n107         )\n108     )\n109     value_and_grad = jax.jit(jax.value_and_grad(objective, has_aux=True))\n110     optimizer = optax.adam(lr)\n111     opt_state = optimizer.init(params)\n112     energy_history = []\n113     loss_history = []\n114     mse_history = []\n115     entropy_history = []\n116     for _ in range(steps):\n117         ((loss, (energy_density, mse, entropies)), grads) = value_and_grad(params)\n118         energy_history.append(float(energy_density))\n119         loss_history.append(float(loss))\n120         mse_history.append(float(mse))\n121         entropy_history.append(np.asarray(entropies))\n122         updates, opt_state = optimizer.update(grads, opt_state, params)\n123         params = optax.apply_updates(params, updates)\n124     return {\n125         \"energy_density_history\": np.asarray(energy_history),\n126         \"loss_history\": np.asarray(loss_history),\n127         \"entropy_mse_history\": np.asarray(mse_history),\n128         \"entropy_history\": np.stack(entropy_history),\n129     }\n","exit_code":0,"status":"completed"}}
