{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, scipy.sparse as sp, scipy.sparse.linalg as sla, time\nn=12; Jz=1.2; h=0.35\n# build via kron\nfrom functools import reduce\nI=np.eye(2,dtype=complex); X=np.array([[0,1],[1,0]],complex); Y=np.array([[0,-1j],[1j,0]],complex); Z=np.diag([1,-1]).astype(complex)\ndef op(sites, ops):\n    mats=[I]*n\n    for i,o in zip(sites,ops): mats[i]=o\n    return reduce(np.kron,mats)\nH=np.zeros((2**n,2**n),complex)\nfor i in range(n-1):\n    H += op([i,i+1],[X,X]) + op([i,i+1],[Y,Y]) + Jz*op([i,i+1],[Z,Z])\nfor i in range(n):\n    H += h*((-1)**i)*op([i],[Z])\nprint('herm err',np.max(np.abs(H-H.conj().T)))\nw=sla.eigsh(H,k=1,which='SA',return_eigenvectors=False)\nprint(w[0]/n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, scipy.sparse as sp, scipy.sparse.linalg as sla, time\nn=12; Jz=1.2; h=0.35\n# build via kron\nfrom functools import reduce\nI=np.eye(2,dtype=complex); X=np.array([[0,1],[1,0]],complex); Y=np.array([[0,-1j],[1j,0]],complex); Z=np.diag([1,-1]).astype(complex)\ndef op(sites, ops):\n    mats=[I]*n\n    for i,o in zip(sites,ops): mats[i]=o\n    return reduce(np.kron,mats)\nH=np.zeros((2**n,2**n),complex)\nfor i in range(n-1):\n    H += op([i,i+1],[X,X]) + op([i,i+1],[Y,Y]) + Jz*op([i,i+1],[Z,Z])\nfor i in range(n):\n    H += h*((-1)**i)*op([i],[Z])\nprint('herm err',np.max(np.abs(H-H.conj().T)))\nw=sla.eigsh(H,k=1,which='SA',return_eigenvectors=False)\nprint(w[0]/n)\nPY\"","aggregated_output":"herm err 0.0\n-2.00036784899688\n","exit_code":0,"status":"completed"}}
