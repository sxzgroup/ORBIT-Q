{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, jax, jax.numpy as jnp, numpy as np, time\ntc.set_backend('jax')\nN=12\n# tiny f using circuit construction from proto, maybe jit\ndef make_state(nb, params):\n    c=tc.Circuit(N)\n    for q in range(1,N,2): c.x(q)\n    return c.state()\ndef f(p):\n    st=make_state(3,p)\n    return jnp.real(jnp.vdot(st,st))\np=jnp.ones((10,),dtype=jnp.float32)\ntry:\n    jf=jax.jit(f)\n    t=time.time(); print(jf(p)); print('compile', time.time()-t)\n    t=time.time(); print(jf(p)); print('run', time.time()-t)\nexcept Exception as e:\n    import traceback; traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
