{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\n# re-run setup then tune hyperparams using same compiled functions\nimport tensorcircuit as tc, jax, jax.numpy as jnp, numpy as np, time, itertools\ntc.set_backend('jax'); n=12; theta=0.31\npair=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(1).at[1,0].set(1)/jnp.sqrt(2)\nbell=pair\nfor _ in range(n//2-1): bell=jnp.kron(bell,pair)\nbell=bell.reshape((2,)*n)\nzero=jnp.zeros((2,)*n,dtype=tc.dtypestr).at[(0,)*n].set(1)\nghz=(jnp.zeros((2,)*n,dtype=tc.dtypestr).at[(0,)*n].set(1).at[(1,)*n].set(1))/jnp.sqrt(2)\nplus=jnp.ones((2,)*n,dtype=tc.dtypestr)/jnp.sqrt(2**n)\nstates=jnp.stack([ghz,bell,zero,plus])\ndef channel(p01,p10):\n s01=jnp.sqrt(1-p01);s10=jnp.sqrt(1-p10);r01=jnp.sqrt(p01);r10=jnp.sqrt(p10)\n k0=jnp.diag(jnp.array([s01,s10],dtype=tc.dtypestr));k1=jnp.zeros((2,2),dtype=tc.dtypestr).at[1,0].set(r10);k2=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(r01)\n return [tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)]\ndef one(inp,p01,p10):\n c=tc.DMCircuit2(n, inputs=inp)\n for i in range(0,n,2):\n  c.rxx(i,i+1,theta=theta)\n  for q in (i,i+1): c.general_kraus(channel(p01,p10),q)\n for i in range(1,n-1,2):\n  c.rxx(i,i+1,theta=theta)\n  for q in (i,i+1): c.general_kraus(channel(p01,p10),q)\n vals=[]\n for i in range(n): vals.append(jnp.real(c.expectation((tc.gates.z(),[i]),reuse=False)))\n vals.append(jnp.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(n)],reuse=False)))\n return jnp.stack(vals)\ndef all_exps(r):\n p01=jax.nn.sigmoid(r[0]); p10=jax.nn.sigmoid(r[1])\n return jnp.stack([one(states[k],p01,p10) for k in range(4)])\nrtrue=jnp.array([jnp.log(0.034/(1-0.034)), jnp.log(0.011/(1-0.011))])\nrinit=jnp.array([jnp.log(0.07/(1-0.07)), jnp.log(0.04/(1-0.04))])\ntable=jax.jit(all_exps); target=table(rtrue)\nvalue_grad=jax.jit(jax.value_and_grad(lambda r: jnp.mean((table(r)-target)**2)))\nvalue_grad(rinit)\ntrue=np.array([.034,.011])\ndef run(b1,b2,eps,lr=.04,steps=120):\n m=jnp.zeros(2);v=jnp.zeros(2);p=rinit; hist=[]\n for t in range(steps):\n  l,g=value_grad(p); hist.append(float(l));m=b1*m+(1-b1)*g;v=b2*v+(1-b2)*g*g;mh=m/(1-b1**(t+1));vh=v/(1-b2**(t+1));p=p-lr*mh/(jnp.sqrt(vh)+eps)\n err=np.max(np.abs(np.array(jax.nn.sigmoid(p))-true)); last=hist[-1]\n return err,last,np.array(jax.nn.sigmoid(p))\nfor b1,b2,eps in [(0.9,0.999,1e-8),(0.9,0.999,1e-7),(0.9,0.999,1e-6),(0.8,0.999,1e-8),(0.5,0.999,1e-8),(0.9,0.99,1e-8),(0.99,0.999,1e-8),(0.9,0.999,1e-10),(0.9,0.9,1e-8)]:\n st=time.time(); err,last,ps=run(b1,b2,eps); print(b1,b2,eps,'err',err,'lastloss',last,'ps',ps,'time',time.time()-st)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
