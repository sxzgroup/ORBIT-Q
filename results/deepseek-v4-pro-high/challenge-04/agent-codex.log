{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, jax, jax.numpy as jnp, numpy as np, time\ntc.set_backend('jax')\nn=12\ntheta=0.31\n\ndef make_statevecs():\n    zero=jnp.zeros((2,)*n, dtype=tc.dtypestr).at[(0,)*n].set(1)\n    plus=jnp.ones((2,)*n, dtype=tc.dtypestr)/jnp.sqrt(2**n)\n    # ghz\n    ghz=jnp.zeros((2,)*n, dtype=tc.dtypestr).at[(0,)*n].set(1).at[(1,)*n].set(1)\n    ghz=ghz/jnp.sqrt(2)\n    # bell product\n    bell=jnp.zeros((2,)*n, dtype=tc.dtypestr)\n    # brute assign via loop? JAX index update maybe static loops okay\n    # build as tensor reshape from one pair repeated\n    pair=jnp.zeros((2,2), dtype=tc.dtypestr).at[0,1].set(1).at[1,0].set(1)/jnp.sqrt(2)\n    # tensor product of 6 pairs\n    tensors=[pair for _ in range(n//2)]\n    bell=pair\n    for _ in range(n//2-1):\n        bell=jnp.kron(bell,pair)\n    bell=bell.reshape((2,)*n)\n    return jnp.stack([ghz,bell,zero,plus])\n\ndef channel(p01,p10):\n    s01=jnp.sqrt(1-p01); s10=jnp.sqrt(1-p10); r01=jnp.sqrt(p01); r10=jnp.sqrt(p10)\n    k0=jnp.diag(jnp.array([s01,s10], dtype=tc.dtypestr))\n    k1=jnp.zeros((2,2),dtype=tc.dtypestr).at[1,0].set(r10)\n    k2=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(r01)\n    return [tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)]\n\ndef one_circuit(inputs, p01, p10):\n    c=tc.DMCircuit2(n, inputs=inputs)\n    for i in range(0,n,2):\n        c.rxx(i,i+1,theta=theta)\n        for q in (i,i+1):\n            c.general_kraus(channel(p01,p10), q)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=theta)\n        for q in (i,i+1):\n            c.general_kraus(channel(p01,p10), q)\n    vals=[]\n    for i in range(n):\n        vals.append(jnp.real(c.expectation((tc.gates.z(),[i]), reuse=False)))\n    vals.append(jnp.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(n)], reuse=False)))\n    return jnp.stack(vals)\n\ndef all_exps(r):\n    p01=jax.nn.sigmoid(r[0]); p10=jax.nn.sigmoid(r[1])\n    states=make_statevecs()\n    out=[]\n    for k in range(4):\n        out.append(one_circuit(states[k],p01,p10))\n    return jnp.stack(out)\n\nr=jnp.array([jnp.log(0.034/(1-0.034)), jnp.log(0.011/(1-0.011))])\nst=time.time(); ex=all_exps(r); print('forward first',time.time()-st, ex.shape)\nprint(ex)\nst=time.time(); ex2=all_exps(r); print('forward second',time.time()-st)\n# gradient\nloss=lambda x: jnp.mean((all_exps(x)-ex)**2)\nst=time.time(); g=jax.grad(loss)(r); print('grad first',time.time()-st, g)\nst=time.time(); g=jax.grad(loss)(r); print('grad second',time.time()-st, g)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
