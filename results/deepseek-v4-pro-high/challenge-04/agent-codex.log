{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np, time, resource, gc\nn=12\ndef build(p01=0.034,p10=0.011):\n    c=tc.DMCircuit2(n)\n    for i in range(0,n,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1):\n            k0=np.diag([np.sqrt(1-p01), np.sqrt(1-p10)]).astype(np.complex64)\n            k1=np.array([[0,0],[np.sqrt(p10),0]], dtype=np.complex64)\n            k2=np.array([[0,np.sqrt(p01)],[0,0]], dtype=np.complex64)\n            c.general_kraus([tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)], q)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1):\n            k0=np.diag([np.sqrt(1-p01), np.sqrt(1-p10)]).astype(np.complex64)\n            k1=np.array([[0,0],[np.sqrt(p10),0]], dtype=np.complex64)\n            k2=np.array([[0,np.sqrt(p01)],[0,0]], dtype=np.complex64)\n            c.general_kraus([tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)], q)\n    return c\nc=build()\nst=time.time()\nfor i in range(n):\n    v=c.expectation((tc.gates.z(),[i]), reuse=False)\nprint('z no reuse',time.time()-st)\nst=time.time(); par=c.expectation(*[(tc.gates.z(),[i]) for i in range(n)], reuse=False); print('par no reuse',time.time()-st, par)\nprint('rss',resource.getrusage(resource.RUSAGE_SELF).ru_maxrss)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
