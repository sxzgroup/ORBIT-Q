{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np, jax, jax.numpy as jnp, time\ntc.set_backend('jax')\nprint('dtype', tc.dtypestr)\nn=12\n\ndef channels_ops(p01,p10):\n    s01=jnp.sqrt(1-p01); s10=jnp.sqrt(1-p10); r01=jnp.sqrt(p01); r10=jnp.sqrt(p10)\n    k0=jnp.diag(jnp.array([s01,s10], dtype=tc.dtypestr))\n    k1=jnp.zeros((2,2),dtype=tc.dtypestr).at[1,0].set(r10)\n    k2=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(r01)\n    return [tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)]\n\ndef build_expectations(r):\n    p01=jax.nn.sigmoid(r[0]); p10=jax.nn.sigmoid(r[1])\n    cs=[]\n    # Use |+>\"'^12 only for gradient test; target initial easy maybe zero.\n    c=tc.DMCircuit2(n)\n    for i in range(n): c.h(i)\n    for i in range(0,n,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1): c.general_kraus(channels_ops(p01,p10), q)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1): c.general_kraus(channels_ops(p01,p10), q)\n    vals=[]\n    for i in range(n):\n        vals.append(jnp.real(c.expectation((tc.gates.z(),[i]), reuse=False)))\n    vals.append(jnp.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(n)], reuse=False)))\n    return jnp.stack(vals)\n\nr=jnp.array([jnp.log(0.07/(1-0.07)), jnp.log(0.04/(1-0.04))])\nst=time.time(); v=build_expectations(r); print('\"'forward', time.time()-st, v)\nprint(jax.grad(lambda x: jnp.sum(build_expectations(x)**2))(r))\nprint('total',time.time()-st)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np, jax, jax.numpy as jnp, time\ntc.set_backend('jax')\nprint('dtype', tc.dtypestr)\nn=12\n\ndef channels_ops(p01,p10):\n    s01=jnp.sqrt(1-p01); s10=jnp.sqrt(1-p10); r01=jnp.sqrt(p01); r10=jnp.sqrt(p10)\n    k0=jnp.diag(jnp.array([s01,s10], dtype=tc.dtypestr))\n    k1=jnp.zeros((2,2),dtype=tc.dtypestr).at[1,0].set(r10)\n    k2=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(r01)\n    return [tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)]\n\ndef build_expectations(r):\n    p01=jax.nn.sigmoid(r[0]); p10=jax.nn.sigmoid(r[1])\n    cs=[]\n    # Use |+>\"'^12 only for gradient test; target initial easy maybe zero.\n    c=tc.DMCircuit2(n)\n    for i in range(n): c.h(i)\n    for i in range(0,n,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1): c.general_kraus(channels_ops(p01,p10), q)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1): c.general_kraus(channels_ops(p01,p10), q)\n    vals=[]\n    for i in range(n):\n        vals.append(jnp.real(c.expectation((tc.gates.z(),[i]), reuse=False)))\n    vals.append(jnp.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(n)], reuse=False)))\n    return jnp.stack(vals)\n\nr=jnp.array([jnp.log(0.07/(1-0.07)), jnp.log(0.04/(1-0.04))])\nst=time.time(); v=build_expectations(r); print('\"'forward', time.time()-st, v)\nprint(jax.grad(lambda x: jnp.sum(build_expectations(x)**2))(r))\nprint('total',time.time()-st)\nPY\"","aggregated_output":"dtype complex64\nforward 1.0453877449035645 [ 3.9286002e-16 -3.2107207e-17  0.0000000e+00  5.2117845e-17\n -9.0851255e-09 -9.0851193e-09 -9.0851255e-09 -9.0851193e-09\n -9.0851255e-09 -9.0851193e-09  1.7531774e-16  0.0000000e+00\n  0.0000000e+00]\n[-5.7820421e-17  2.7284837e-16]\ntotal 3.379314661026001\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np, jax, jax.numpy as jnp, time\ntc.set_backend('jax')\nn=12\n\ndef channels_ops(p01,p10):\n    s01=jnp.sqrt(1-p01); s10=jnp.sqrt(1-p10); r01=jnp.sqrt(p01); r10=jnp.sqrt(p10)\n    k0=jnp.diag(jnp.array([s01,s10], dtype=tc.dtypestr))\n    k1=jnp.zeros((2,2),dtype=tc.dtypestr).at[1,0].set(r10)\n    k2=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(r01)\n    return [tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)]\n\ndef build_expectations(r):\n    p01=jax.nn.sigmoid(r[0]); p10=jax.nn.sigmoid(r[1])\n    c=tc.DMCircuit2(n)\n    for i in range(n): c.h(i)\n    for i in range(0,n,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1): c.general_kraus(channels_ops(p01,p10), q)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=0.31)\n        for q in (i,i+1): c.general_kraus(channels_ops(p01,p10), q)\n    vals=[]\n    for i in range(n):\n        vals.append(jnp.real(c.expectation((tc.gates.z(),[i]), reuse=False)))\n    vals.append(jnp.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(n)], reuse=False)))\n    return jnp.stack(vals)\n\nr=jnp.array([jnp.log(0.07/(1-0.07)), jnp.log(0.04/(1-0.04))])\ngradf=jax.jit(jax.value_and_grad(lambda x: jnp.sum(build_expectations(x)**2)))\n# warm\nfor _ in range(3):\n    v,g=gradf(r); print('iter',v, g)\nprint('done warm')\nst=time.time()\nfor _ in range(5):\n    v,g=gradf(r)\nprint('5 jit', time.time()-st)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
