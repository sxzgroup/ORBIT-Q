{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, jax, jax.numpy as jnp, numpy as np, time, math\ntc.set_backend('jax')\nn=12; theta=0.31\n# state vectors\npair=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(1).at[1,0].set(1)/jnp.sqrt(2)\nbell=pair\nfor _ in range(n//2-1): bell=jnp.kron(bell,pair)\nbell=bell.reshape((2,)*n)\nzero=jnp.zeros((2,)*n,dtype=tc.dtypestr).at[(0,)*n].set(1)\nghz=(jnp.zeros((2,)*n,dtype=tc.dtypestr).at[(0,)*n].set(1).at[(1,)*n].set(1))/jnp.sqrt(2)\nplus=jnp.ones((2,)*n,dtype=tc.dtypestr)/jnp.sqrt(2**n)\nstates=jnp.stack([ghz,bell,zero,plus])\n\ndef channel(p01,p10):\n s01=jnp.sqrt(1-p01);s10=jnp.sqrt(1-p10);r01=jnp.sqrt(p01);r10=jnp.sqrt(p10)\n k0=jnp.diag(jnp.array([s01,s10],dtype=tc.dtypestr))\n k1=jnp.zeros((2,2),dtype=tc.dtypestr).at[1,0].set(r10)\n k2=jnp.zeros((2,2),dtype=tc.dtypestr).at[0,1].set(r01)\n return [tc.Gate(k0),tc.Gate(k1),tc.Gate(k2)]\n\ndef one(inp,p01,p10):\n c=tc.DMCircuit2(n, inputs=inp)\n for i in range(0,n,2):\n  c.rxx(i,i+1,theta=theta)\n  for q in (i,i+1): c.general_kraus(channel(p01,p10),q)\n for i in range(1,n-1,2):\n  c.rxx(i,i+1,theta=theta)\n  for q in (i,i+1): c.general_kraus(channel(p01,p10),q)\n vals=[]\n for i in range(n): vals.append(jnp.real(c.expectation((tc.gates.z(),[i]),reuse=False)))\n vals.append(jnp.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(n)],reuse=False)))\n return jnp.stack(vals)\n\ndef all_exps(r):\n p01=jax.nn.sigmoid(r[0]); p10=jax.nn.sigmoid(r[1])\n return jnp.stack([one(states[k],p01,p10) for k in range(4)])\n\nrtrue=jnp.array([jnp.log(0.034/(1-0.034)), jnp.log(0.011/(1-0.011))])\nrinit=jnp.array([jnp.log(0.07/(1-0.07)), jnp.log(0.04/(1-0.04))])\ntable_fn=jax.jit(all_exps)\nst=time.time(); target=table_fn(rtrue); print('target compile',time.time()-st, target.shape)\nloss=lambda r: jnp.mean((table_fn(r)-target)**2)\nvalue_grad=jax.jit(jax.value_and_grad(loss))\n# warm\nst=time.time(); l,g=value_grad(rinit); print('compile',time.time()-st,l,g)\n# Adam\nm=jnp.zeros(2); v=jnp.zeros(2); beta1=0.9; beta2=0.999; eps=1e-8; lr=0.04\nparams=rinit\nhistory=np.empty(120, dtype=np.float64)\nst=time.time()\nfor t in range(120):\n lossv, grad=value_grad(params)\n history[t]=float(np.asarray(lossv))\n m=beta1*m+(1-beta1)*grad\n v=beta2*v+(1-beta2)*grad**2\n mhat=m/(1-beta1**(t+1)); vhat=v/(1-beta2**(t+1))\n params=params-lr*mhat/(jnp.sqrt(vhat)+eps)\nprint('train loop',time.time()-st)\nprint('final p', jax.nn.sigmoid(params), 'loss history first last',history[0],history[-1])\nprint('errors', np.array(jax.nn.sigmoid(params))-np.array([0.034,0.011]))\nfinal_ex=table_fn(params)\nprint('final ex shape',final_ex.shape)\nprint(final_ex)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
