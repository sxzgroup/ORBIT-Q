ates', 'diagonal', 'draw', 'exp', 'exp1', 'expectation', 'expectation_before', 'expectation_ps', 'fredkin', 'from_cirq', 'from_json', 'from_json_file', 'from_openqasm', 'from_openqasm_file', 'from_qir', 'from_qiskit', 'from_qsim_file', 'front_from_nodes', 'gate_aliases', 'gate_count', 'gate_count_by_condition', 'gate_summary', 'general_kraus', 'generaldepolarizing', 'get_dm_as_quoperator', 'get_dm_as_quvector', 'get_positional_logical_mapping', 'get_quvector', 'h', 'i', 'initial_mapping', 'inverse', 'is_dm', 'is_mps', 'isotropicdepolarizing', 'iswap', 'measure', 'measure_instruction', 'measure_jit', 'mpo', 'mpogates', 'mr_instruction', 'multicontrol', 'orx', 'ory', 'orz', 'outcome_probability', 'ox', 'oy', 'oz', 'pauli2_instruction', 'pauli_instruction', 'perfect_sampling', 'phase', 'phasedamping', 'prepend', 'probability', 'projected_subsystem', 'quvector', 'r', 'readouterror_bs', 'replace_inputs', 'reset', 'reset_instruction', 'rx', 'rxx', 'ry', 'ryy', 'rz', 'rzm', 'rzz', 's', 'sample', 'sample_detector', 'sample_expectation_ps', 'sd', 'sdg', 'select_gate', 'sexpps', 'sgates', 'standardize_gate', 'state', 'su4', 'swap', 't', 'td', 'tdg', 'tex', 'thermalrelaxation', 'to_circuit', 'to_cirq', 'to_graphviz', 'to_json', 'to_openqasm', 'to_openqasm_file', 'to_qir', 'to_qiskit', 'toffoli', 'u', 'unitary', 'vgates', 'vis_tex', 'wavefunction', 'wroot', 'x', 'y', 'z']\ngates with channel\n[]\n","exit_code":0,"status":"completed"}}
