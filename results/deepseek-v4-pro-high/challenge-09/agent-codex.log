mp[q]) for pn,q in p])\n# note if two observables share target qubit? no, but use same circuit\ndef f(params):\n c=tc.Circuit(len(qs))\n for name,q,pos in gates:\n  getattr(c,name)(*q, theta=params[pos])\n e1=c.expectation(*tuple((getattr(tc.gates,pn)(), [qq]) for pn,qq in ops_list[0]))\n e2=c.expectation(*tuple((getattr(tc.gates,pn)(), [qq]) for pn,qq in ops_list[1]))\n return -(terms[0][0]*tc.backend.real(e1)+terms[1][0]*tc.backend.real(e2))\nparams=jnp.array(np.random.default_rng(0).normal(0,.02,size=pos))\nvg=jax.jit(jax.value_and_grad(f))\nprint('compile')\nt=time.time(); print(vg(params)); print('first',time.time()-t)\nt=time.time()\nfor _ in range(100): vg(params)\nprint('100 calls',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
