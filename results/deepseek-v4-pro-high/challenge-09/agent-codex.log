{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nconfig={\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"max_steps\\\":100,\\\"n_restarts\\\":200,\\\"learning_rate\\\":0.03,\\\"initial_parameter_scale\\\":0.02,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24,\\\"success_threshold\\\":1.0}\n\ndef ladder_edges(n):\n    assert n%2==0\n    nc=n//2\n    edges=[]\n    for col in range(nc):\n        edges.append((2*col,2*col+1))\n        if col+1<nc:\n            edges.append((2*col,2*(col+1)))\n            edges.append((2*col+1,2*(col+1)+1))\n            if col%2==0:\n                edges.append((2*col,2*(col+1)+1))\n            else:\n                edges.append((2*col+1,2*(col+1)))\n    return edges\n\ndef gen(config):\n    rng=np.random.default_rng(config['seed'])\n    single=('rx','ry','rz'); two=('rxx','ryy','rzz')\n    edges=ladder_edges(config['n_qubits'])\n    tape=[]; pi=0\n    for _ in range(config['n_layers']):\n      for q in range(config['n_qubits']):\n        axis=single[int(rng.integers(len(single)))]\n        tape.append((axis,q,pi)); pi+=1\n      e=list(edges); rng.shuffle(e); used=set()\n      for a,b in e:\n        if a in used or b in used: continue\n        if rng.random()>config['edge_keep_prob']: continue\n        axis=two[int(rng.integers(len(two)))]\n        tape.append((axis,a,b,pi)); pi+=1\n        used.add(a); used.add(b)\n    return tuple(tape), pi\ntape,pc=gen(config)\nprint('tape',len(tape),'pc',pc)\n# cones\nterms=((0.5645931361768194,(('x',388),('z',390))),(1.0,(('x',16),('y',19))))\nfor coeff,paulis in terms:\n    active=set([q for _,q in paulis])\n    gates=[]\n    for idx,gate in enumerate(tape):\n      qs=gate[1:3] if len(gate)==4 else gate[1:2]\n      if any(q in active for q in qs):\n        gates.append((idx,gate))\n        active.update(qs)\n    print('term paulis',paulis,'nqubits',len(active),'gates',len(gates),'params',sum(1 for _,g in gates))\n    print('active sorted',sorted(active)[:100])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
