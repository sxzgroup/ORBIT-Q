{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp\n\ndef ladder_edges(n):\n    assert n%2==0\n    nc=n//2\n    edges=[]\n    for col in range(nc):\n        edges.append((2*col,2*col+1))\n        if col+1<nc:\n            edges.append((2*col,2*(col+1)))\n            edges.append((2*col+1,2*(col+1)+1))\n            if col%2==0:\n                edges.append((2*col,2*(col+1)+1))\n            else:\n                edges.append((2*col+1,2*(col+1)))\n    return edges\n\ndef gen(n,layers,seed,p=1.0):\n    rng=np.random.default_rng(seed)\n    single=('rx','ry','rz'); two=('rxx','ryy','rzz')\n    edges=ladder_edges(n); tape=[]; pi=0\n    for _ in range(layers):\n      for q in range(n):\n        axis=single[int(rng.integers(3))]; tape.append((axis,q,pi)); pi+=1\n      e=list(edges); rng.shuffle(e); used=set()\n      for a,b in e:\n        if a in used or b in used: continue\n        if rng.random()>p: continue\n        axis=two[int(rng.integers(3))]; tape.append((axis,a,b,pi)); pi+=1; used.add(a); used.add(b)\n    return tuple(tape),pi\n\nn=12\ntape,pc=gen(n,3,42,1.0)\ntheta=np.random.default_rng(0).normal(0,0.5,size=pc)\n# full\nc=tc.Circuit(n)\nfor g in tape:\n  if len(g)==3: getattr(c,g[0])(g[1], theta=theta[g[2]])\n  else: getattr(c,g[0])(g[1],g[2], theta=theta[g[3]])\n# choose terms\nterms=[((0.5, (('x',2),('z',4))),), ((1.0,(('x',3),('y',7))),)]\n# Better test both\npaulis=[(('x',2),('z',4)), (('x',3),('y',7))]\n# full vals\nfor p in paulis:\n    ops=[(getattr(tc.gates,op), [q]) for op,q in p]\n    print('full',p, c.expectation(*ops))\n# reduced\nfor p in paulis:\n    active=set(q for _,q in p)\n    gates=[]\n    for gi,g in enumerate(tape):\n      qs=g[1:3] if len(g)==4 else g[1:2]\n      if any(q in active for q in qs):\n        gates.append((gi,g)); active.update(qs)\n    qs=sorted(active); mp={q:i for i,q in enumerate(qs)}\n    cc=tc.Circuit(len(qs))\n    for gi,g in gates:\n      if len(g)==3: getattr(cc,g[0])(mp[g[1]], theta=theta[g[2]])\n      else: getattr(cc,g[0])(mp[g[1]],mp[g[2]], theta=theta[g[3]])\n    ops=[(getattr(tc.gates,op), [mp[q]]) for op,q in p]\n    print('reduced',p,'nq',len(qs),'ng',len(gates),cc.expectation(*ops))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
