{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, time\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp\n# generate full\nconfig={\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24}\ndef ladder_edges(n):\n    nc=n//2; edges=[]\n    for col in range(nc):\n      edges.append((2*col,2*col+1))\n      if col+1<nc:\n        edges.append((2*col,2*(col+1))); edges.append((2*col+1,2*(col+1)+1))\n        if col%2==0: edges.append((2*col,2*(col+1)+1))\n        else: edges.append((2*col+1,2*(col+1)))\n    return edges\ndef gen(config):\n    rng=np.random.default_rng(config['seed']); single=('rx','ry','rz'); two=('rxx','ryy','rzz'); edges=ladder_edges(config['n_qubits']); tape=[]; pi=0\n    for _ in range(config['n_layers']):\n      for q in range(config['n_qubits']): tape.append((single[int(rng.integers(3))],q,pi)); pi+=1\n      e=list(edges); rng.shuffle(e); used=set()\n      for a,b in e:\n        if a in used or b in used: continue\n        if rng.random()>config['edge_keep_prob']: continue\n        tape.append((two[int(rng.integers(3))],a,b,pi)); pi+=1; used.add(a); used.add(b)\n    return tuple(tape),pi\ntape,pc=gen(config)\npaulis=((('x',388),('z',390)),)\n# build term\nactive=set(q for _,q in paulis[0]); rev=[]\nfor gi in range(len(tape)-1,-1,-1):\n g=tape[gi]; qs=g[1:3] if len(g)==4 else g[1:2]\n if any(q in active for q in qs): rev.append((gi,g)); active.update(qs)\nrev=rev[::-1]; qs=sorted(active); mp={q:i for i,q in enumerate(qs)}\nops=[(p,mp[q]) for p,q in paulis[0]]\ngates=[]; pidx=[]; pos=0\nfor gi,g in rev:\n if len(g)==3:\n  name=g[0]; q=(mp[g[1]],); p=g[2]\n else:\n  name=g[0]; q=(mp[g[1]],mp[g[2]]); p=g[3]\n gates.append((name,q,pos)); pidx.append(p); pos+=1\n\ndef exp_fun(params):\n c=tc.Circuit(len(qs))\n for name,q,pos in gates:\n  getattr(c,name)(*q, theta=params[pos])\n opsnodes=tuple((getattr(tc.gates,pn)(), [qq]) for pn,qq in ops)\n return tc.backend.real(c.expectation(*opsnodes))\n\nparams=jnp.array(np.random.default_rng(0).normal(0,.02,size=pos))\nvg=jax.jit(jax.value_and_grad(exp_fun))\nprint('compiling')\nt=time.time(); print(vg(params)); print('first',time.time()-t)\nt=time.time()\nfor _ in range(100): vg(params)\nprint('100 calls',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
