{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/build_peps.py <<'PY'\nimport numpy as np, math, time\nimport tensorcircuit as tc\nimport tensornetwork as tn\n\ntc.set_backend('numpy')\nbackend=tc.backend\nnpdtype=np.complex64\n\ndef split_zzxx(gate, left_site=True):\n    # gate tensor axes [o0,o1,i0,i1]\n    a=np.asarray(gate.tensor)\n    a=np.transpose(a,(0,2,1,3))  # [o_i,i_i,o_j,i_j]\n    M=a.reshape(4,4)\n    u,s,vh,_=backend.svd(M)\n    # rank 2\n    chi=2\n    u=u[:,:chi].reshape(2,2,chi)\n    vh=vh[:chi,:].reshape(chi,2,2)\n    # absorb singular values into u\n    u=u*s.reshape(1,1,chi)\n    # left axes [o,i,bond], right axes [bond,o,i]\n    return u if left_site else vh\n\ndef apply_single(U, cur, axes):\n    return np.einsum('oi,i...->o...', U, cur)\n\ndef apply_left(A, cur, axes):\n    nb=len(axes)\n    ins=','.join([f'o,i,b{nb}']+[f'i']+[f'b{k}' for k in range(nb)])\n    out=''.join(['o']+[f'b{k}' for k in range(nb)]+[f'b{nb}'])\n    return np.einsum(ins, A, cur)\n\ndef apply_right(A, cur, axes):\n    nb=len(axes)\n    ins=','.join([f'b{nb},o,i']+[f'i']+[f'b{k}' for k in range(nb)])\n    out=''.join(['o']+[f'b{k}' for k in range(nb)]+[f'b{nb}'])\n    return np.einsum(ins, A, cur)\n\ndef build_site(r,c,s,cfg):\n    # returns ndarray axes [p, L?, R?, U?, D?]\n    vec0=np.array([1,0],dtype=npdtype)\n    cur=vec0\n    axes=[]\n    ry=tc.gates.ry(theta=alpha(r,c,cfg)).tensor\n    cur=apply_single(ry,cur,axes)\n    # horizontal edges order: left edge (if c>0), right edge (if c<6)\n    # we'll create split tensors on the fly for each neighbor\n    def attach(gate, is_left):\n        nonlocal cur, axes\n        A=split_zzxx(gate, left_site=is_left)\n        if is_left:\n            cur=apply_left(A,cur,axes)\n        else:\n            cur=apply_right(A,cur,axes)\n        axes.append('h')\n    if c>0:\n        k= c-1 # horizontal edge index in row: c-1? Need function for beta_h maybe\n        # use config formulas\n        # Need proper k_h and angle\n        theta=beta_h(r,c-1,k,cfg)\n        attach(tc.gates.rzz(theta=theta), False)  # site right endpoint of edge => right tensor\n    if c<s-1:\n        k=c\n        theta=beta_h(r,c,k,cfg)\n        attach(tc.gates.rzz(theta=theta), True)\n    # vertical: up if r>0, down if r<s-1\n    def attach_v(gate, is_left):\n        nonlocal cur, axes\n        A=split_zzxx(gate, left_site=is_left)\n        if is_left:\n            cur=apply_left(A,cur,axes)\n        else:\n            cur=apply_right(A,cur,axes)\n        axes.append('v')\n    if r>0:\n        # edge index kv: row-major vertical edges (0..s-1)* (s-1)? For edge r-1,c\n        # vertical edge order k_v = (r-1)*s + c? because for each row r0 0..s-2, for c 0..s-1\n        k=(r-1)*s+c\n        theta=beta_v(r-1,c,k,cfg)\n        attach_v(tc.gates.rxx(theta=theta), False)  # bottom endpoint\n    if r<s-1:\n        k=r*s+c\n        theta=beta_v(r,c,k,cfg)\n        attach_v(tc.gates.rxx(theta=theta), True)\n    rx=tc.gates.rx(theta=gamma(r,c,cfg)).tensor\n    cur=apply_single(rx,cur,axes)\n    return cur\n\ndef alpha(r,c,cfg):\n    return cfg['ry_offset']+cfg['ry_row_sin_scale']*math.sin(cfg['ry_row_sin_frequency']*(r+1))+cfg['ry_col_cos_scale']*math.cos(cfg['ry_col_cos_frequency']*(c+1))+cfg['ry_diag_sin_scale']*math.sin(cfg['ry_diag_sin_frequency']*(r+c+2))\ndef gamma(r,c,cfg):\n    return cfg['rx_offset']+cfg['rx_row_cos_scale']*math.cos(cfg['rx_row_cos_frequency']*(r+1))-cfg['rx_col_sin_scale']*math.sin(cfg['rx_col_sin_frequency']*(c+1))+cfg['rx_diag_cos_scale']*math.cos(cfg['rx_diag_cos_frequency']*(r+c+2))\ndef beta_h(r,c,k,cfg):\n    return cfg['rzz_offset']+cfg['rzz_edge_sin_scale']*math.sin(cfg['rzz_edge_sin_frequency']*(k+1))+cfg['rzz_site_cos_scale']*math.cos(cfg['rzz_site_cos_frequency']*(2*r+c+1))\ndef beta_v(r,c,k,cfg):\n    return cfg['rxx_offset']+cfg['rxx_edge_cos_scale']*math.cos(cfg['rxx_edge_cos_frequency']*(k+1))+cfg['rxx_site_sin_scale']*math.sin(cfg['rxx_site_sin_frequency']*(r+2*c+1))\n\ncfg=dict(grid_side=7,n_qubits=49,n_samples=8192,ry_offset=0.19,ry_row_sin_scale=0.07,ry_row_sin_frequency=0.83,ry_col_cos_scale=0.05,ry_col_cos_frequency=0.61,ry_diag_sin_scale=0.03,ry_diag_sin_frequency=0.29,rzz_offset=0.31,rzz_edge_sin_scale=0.09,rzz_edge_sin_frequency=0.47,rzz_site_cos_scale=0.06,rzz_site_cos_frequency=0.38,rxx_offset=0.27,rxx_edge_cos_scale=0.08,rxx_edge_cos_frequency=0.41,rxx_site_sin_scale=0.07,rxx_site_sin_frequency=0.33,rx_offset=0.17,rx_row_cos_scale=0.06,rx_row_cos_frequency=0.52,rx_col_sin_scale=0.04,rx_col_sin_frequency=0.44,rx_diag_cos_scale=0.02,rx_diag_cos_frequency=0.25)\ns=cfg['grid_side']\nnodes=[]\nfor r in range(s):\n row=[]\n for c in range(s):\n  arr=build_site(r,c,s,cfg)\n  print(r,c,arr.shape)\n  row.append(tn.Node(arr))\n nodes.append(row)\n# connect\nfor r in range(s):\n for c in range(s-1):\n  nodes[r][c][2] \"'^ nodes[r][c+1][1]\nfor r in range(s-1):\n for c in range(s):\n  nodes[r][c][4] ''^ nodes[r+1][c][3]\nallnodes=[n for row in nodes for n in row]\n# contract with no physical edges? just scalar norm. To compute marginal first site, fix all but first? Let'\"'s contract scalar with first physical kept maybe.\n# First test full scalar norm by contracting all nodes (no output edges) should be 1\nimport tensorcircuit.cons as cons\nt=time.time()\nres=cons.contractor(allnodes)\nprint('scalar', time.time()-t, res.tensor)\n# marginal first site squared: use two copies and all physical except first connected.\nnodes1,front1=[],[]\nfor row in nodes:\n for n in row:\n  n2=n.copy()\n  nodes1.extend([n,n2])\n# Need connect corresponding physical edges except first; can use tn.copy to get edges mapping? easier: create ket and bra copies from original allnodes/front.\nfront=[nodes[r][c][0] for r in range(s) for c in range(s)]\nPY\npython /tmp/build_peps.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
