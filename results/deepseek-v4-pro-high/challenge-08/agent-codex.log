ur,M[i],Rlist[i]); q=jnp.abs(amp)**2\n  key,subkey=jax.random.split(key)\n  x=jax.random.categorical(subkey,jnp.log(q+1e-30))\n  At=jnp.transpose(M[i],(1,0,2)); Asel=At[x]\n  Lnew=jnp.einsum('ba,bac->bc',Lcur,Asel)\n  norm=jnp.linalg.norm(Lnew,axis=1,keepdims=True); Lcur=Lnew/jnp.maximum(norm,1e-30)\n  xs.append(x)\n return jnp.stack(xs,axis=1)\nB=8192\njitted=jax.jit(sample_batch,static_argnums=(3,))\nkey=jax.random.PRNGKey(0)\nt=time.time(); xs=jitted(key,M_j,tuple(Rlist),B); jax.block_until_ready(xs); print('sample jit+run',time.time()-t)\nxs=np.array(xs); print(xs.shape,xs[:2])\n# convert and print bits\nbits=np.stack([(xs>>c)&1 for c in range(s)],axis=2).reshape(B,-1)\nprint(bits.shape,bits[:2])\nPY\npython /tmp/full_bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
