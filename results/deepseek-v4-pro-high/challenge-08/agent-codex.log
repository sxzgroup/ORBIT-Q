{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/order_scope.py <<'PY'\nimport networkx as nx, itertools, math\ns=7\n# variable ids: physical (r,c)=0..48; hidden horizontal h(r,c) for c=0..5, vertical v(r,c) r=0..5\nvars=[]; phys={}\nfor r in range(s):\n for c in range(s):\n  phys[(r,c)]=len(vars); vars.append(('p',r,c))\nhids={}; vids={}\nfor r in range(s):\n for c in range(s-1):\n  hids[(r,c)]=len(vars); vars.append(('h',r,c))\nfor r in range(s-1):\n for c in range(s):\n  vids[(r,c)]=len(vars); vars.append(('v',r,c))\nG=nx.Graph(); G.add_nodes_from(range(len(vars)))\nscopes=[]\nfor r in range(s):\n for c in range(s):\n  scope=[phys[(r,c)]]\n  if c>0: scope.append(hids[(r,c-1)])\n  if c<s-1: scope.append(hids[(r,c)])\n  if r>0: scope.append(vids[(r-1,c)])\n  if r<s-1: scope.append(vids[(r,c)])\n  scopes.append(tuple(scope))\n  for a,b in itertools.combinations(scope,2): G.add_edge(a,b)\nprint('vars',len(vars),'factors',len(scopes))\n# min fill heuristic with randomized? networkx min_fill_in heuristic uses approximate.\ndef width(order):\n pos={v:i for i,v in enumerate(order)}\n maxw=0\n for v in order:\n  neigh=[u for u in G.neighbors(v) if pos[u]>pos[v]]\n  maxw=max(maxw,len(neigh))\n return maxw\n# greedy min fill based on interaction graph using networkx's approximation functions maybe.\n# Try row-major physical then hidden etc.\norders=[]\n# physical then hidden h then v\norders.append([phys[(r,c)] for r in range(s) for c in range(s)] + [hids[(r,c)] for r in range(s) for c in range(s-1)] + [vids[(r,c)] for r in range(s-1) for c in range(s)])\n# hidden then physical\norders.append([hids[(r,c)] for r in range(s) for c in range(s-1)] + [vids[(r,c)] for r in range(s-1) for c in range(s)] + [phys[(r,c)] for r in range(s) for c in range(s)])\n# reverse\norders.append(orders[0][::-1]); orders.append(orders[1][::-1])\nfor o in orders:\n print('order width',width(o))\n# networkx min degree\nfor func in [nx.algorithms.approximation.treewidth_min_degree, nx.algorithms.approximation.treewidth_min_fill_in]:\n try:\n  tw,decomp=func(G)\n  print(func.__name__,'tw',tw)\n except Exception as e: print(func,e)\nPY\npython /tmp/order_scope.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
