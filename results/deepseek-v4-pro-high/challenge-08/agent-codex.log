{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\np='/tmp/build_peps.py'\ns=open(p).read()\nold=\\\"\\\"\\\"def apply_left(A, cur, axes):\n    nb=len(axes)\n    a_axes=''.join([f'o',f'i',f'b{nb}'])\n    cur_axes=''.join([f'i']+[f'b{k}' for k in range(nb)])\n    out_axes=''.join([f'o']+[f'b{k}' for k in range(nb)]+[f'b{nb}'])\n    ins=a_axes+','+cur_axes+'->'+out_axes\n    return np.einsum(ins, A, cur)\n\ndef apply_right(A, cur, axes):\n    nb=len(axes)\n    a_axes=''.join([f'b{nb}',f'o',f'i'])\n    cur_axes=''.join([f'i']+[f'b{k}' for k in range(nb)])\n    out_axes=''.join([f'o']+[f'b{k}' for k in range(nb)]+[f'b{nb}'])\n    ins=a_axes+','+cur_axes+'->'+out_axes\n    return np.einsum(ins, A, cur)\n\\\"\\\"\\\"\nnew=\\\"\\\"\\\"def _labels(n):\n    # return physical old, physical new, and bond labels\n    return 'a','b',['c','d','e','f','g'][:n]\n\ndef apply_left(A, cur, axes):\n    nb=len(axes)\n    old,new,existing=_labels(nb)\n    bond=chr(ord('h')+nb) if nb<4 else 'z'\n    a_axes=new+old+bond\n    cur_axes=old+''.join(existing)\n    out_axes=new+''.join(existing)+bond\n    return np.einsum(a_axes+','+cur_axes+'->'+out_axes, A, cur)\n\ndef apply_right(A, cur, axes):\n    nb=len(axes)\n    old,new,existing=_labels(nb)\n    bond=chr(ord('h')+nb) if nb<4 else 'z'\n    a_axes=bond+new+old\n    cur_axes=old+''.join(existing)\n    out_axes=new+''.join(existing)+bond\n    return np.einsum(a_axes+','+cur_axes+'->'+out_axes, A, cur)\n\\\"\\\"\\\"\n# Also update apply_single\nold_single=\\\"\\\"\\\"def apply_single(U, cur, axes):\n    return np.einsum('oi,i...->o...', U, cur)\n\\\"\\\"\\\"\nnew_single=\\\"\\\"\\\"def apply_single(U, cur, axes):\n    old,new,existing=_labels(len(axes))\n    cur_axes=old+''.join(existing)\n    out_axes=new+''.join(existing)\n    return np.einsum(new+old+','+cur_axes+'->'+out_axes, U, cur)\n\\\"\\\"\\\"\n# Need define _labels before apply_single; currently apply_single before apply_left. Add function before apply_single.\nif 'def _labels' not in s:\n s=s.replace('def apply_single', 'def _labels(n):\\\\n    return \\\\'a\\\\',\\\\'b\\\\',[\\\\'c\\\\',\\\\'d\\\\',\\\\'e\\\\',\\\\'f\\\\',\\\\'g\\\\'][:n]\\\\n\\\\ndef apply_single')\ns=s.replace(old_single,new_single)\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython /tmp/build_peps.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
