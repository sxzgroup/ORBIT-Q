{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport jax,jax.numpy as jnp,time\nB=8192; d=128; chi=128\nA=jax.random.normal(jax.random.PRNGKey(0),[d,chi,chi],dtype=jnp.float32)\nL=jax.random.normal(jax.random.PRNGKey(1),[B,chi],dtype=jnp.float32)\nR=jax.random.normal(jax.random.PRNGKey(2),[B,chi],dtype=jnp.float32)\n# q = L @ A @ R per batch\ndef qfun(L,R,A):\n return jnp.einsum('Ba,adc,Bc->Bd',L,A,R)\nqj=jax.jit(qfun)\nt=time.time(); q=qj(L,R,A); jax.block_until_ready(q); print('compile+run q row',time.time()-t)\nt=time.time()\nfor _ in range(7): q=qj(L,R,A); jax.block_until_ready(q)\nprint('7 q row',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
