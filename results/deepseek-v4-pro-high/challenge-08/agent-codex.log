{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_pairwise.py <<'PY'\nimport numpy as np, math, tensorcircuit as tc\n# use exact state for 3x3 and compute all probs\ns=3; n=s*s\ncfg=dict(ry_offset=0.19,ry_row_sin_scale=0.07,ry_row_sin_frequency=0.83,ry_col_cos_scale=0.05,ry_col_cos_frequency=0.61,ry_diag_sin_scale=0.03,ry_diag_sin_frequency=0.29,rzz_offset=0.31,rzz_edge_sin_scale=0.09,rzz_edge_sin_frequency=0.47,rzz_site_cos_scale=0.06,rzz_site_cos_frequency=0.38,rxx_offset=0.27,rxx_edge_cos_scale=0.08,rxx_edge_cos_frequency=0.41,rxx_site_sin_scale=0.07,rxx_site_sin_frequency=0.33,rx_offset=0.17,rx_row_cos_scale=0.06,rx_row_cos_frequency=0.52,rx_col_sin_scale=0.04,rx_col_sin_frequency=0.44,rx_diag_cos_scale=0.02,rx_diag_cos_frequency=0.25)\ndef alpha(r,c): return cfg['ry_offset']+cfg['ry_row_sin_scale']*math.sin(cfg['ry_row_sin_frequency']*(r+1))+cfg['ry_col_cos_scale']*math.cos(cfg['ry_col_cos_frequency']*(c+1))+cfg['ry_diag_sin_scale']*math.sin(cfg['ry_diag_sin_frequency']*(r+c+2))\ndef gamma(r,c): return cfg['rx_offset']+cfg['rx_row_cos_scale']*math.cos(cfg['rx_row_cos_frequency']*(r+1))-cfg['rx_col_sin_scale']*math.sin(cfg['rx_col_sin_frequency']*(c+1))+cfg['rx_diag_cos_scale']*math.cos(cfg['rx_diag_cos_frequency']*(r+c+2))\ndef bh(r,c,k): return cfg['rzz_offset']+cfg['rzz_edge_sin_scale']*math.sin(cfg['rzz_edge_sin_frequency']*(k+1))+cfg['rzz_site_cos_scale']*math.cos(cfg['rzz_site_cos_frequency']*(2*r+c+1))\ndef bv(r,c,k): return cfg['rxx_offset']+cfg['rxx_edge_cos_scale']*math.cos(cfg['rxx_edge_cos_frequency']*(k+1))+cfg['rxx_site_sin_scale']*math.sin(cfg['rxx_site_sin_frequency']*(r+2*c+1))\nc=tc.Circuit(n)\nfor r in range(s):\n for col in range(s): c.ry(r*s+col,theta=alpha(r,col))\nkh=0\nfor r in range(s):\n for col in range(s-1): c.rzz(r*s+col,r*s+col+1,theta=bh(r,col,kh)); kh+=1\nkv=0\nfor r in range(s-1):\n for col in range(s): c.rxx(r*s+col,(r+1)*s+col,theta=bv(r,col,kv)); kv+=1\nfor r in range(s):\n for col in range(s): c.rx(r*s+col,theta=gamma(r,col))\nw=np.asarray(c.wavefunction())\np=np.abs(w.reshape([2]*n))**2\n# Fit pairwise MRF using iterative proportional? Use logistic regression on all configurations.\nX=[]; y=[]; logp=np.log(np.maximum(p,1e-300))\nfor idx in range(2**n):\n bits=np.array([(idx>>i)&1 for i in range(n)],dtype=float)\n # feature intercept, unary bits, horizontal products, vertical products\n feat=[1.0]\n feat.extend(bits)\n for r in range(s):\n  for col in range(s-1): feat.append(bits[r*s+col]*bits[r*s+col+1])\n for r in range(s-1):\n  for col in range(s): feat.append(bits[r*s+col]*bits[(r+1)*s+col])\n X.append(feat); y.append(logp[idx])\nX=np.array(X); y=np.array(y)\ncoef,res,rank,sv=np.linalg.lstsq(X,y,rcond=None)\npred=X@coef\nprint('res norm',np.linalg.norm(pred-y),'max',np.max(np.abs(pred-y)),'rank',rank,'coef',coef)\nprint('max p rel',np.max(np.abs(np.exp(pred)-p)))\n# Check conditional independence: maybe log linear exact rank\nprint('sv smallest',sv[:5], sv[-5:])\nPY\npython /tmp/test_pairwise.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
