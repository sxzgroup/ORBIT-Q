{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport jax, jax.numpy as jnp, time\nB=8192; chi=128\nA=jax.random.normal(jax.random.PRNGKey(0),[chi,chi,2],dtype=jnp.float32)\nL=jax.random.normal(jax.random.PRNGKey(1),[B,chi],dtype=jnp.float32)\nR=jax.random.normal(jax.random.PRNGKey(2),[B,chi],dtype=jnp.float32)\ndef step(L,R):\n q=jnp.einsum('ba,abp,bc->bp',L,A,R)\n # sample argmax just for benchmark\n p=jnp.argmax(q,axis=1)\n # update both possibilities and select? benchmark computing both updates\n L0=jnp.einsum('ba,ab->b?',L,A[:,:,0]) # wrong output names\n return q,p\nstep_j=jax.jit(step)\n# fix L0\ndef upd(L,p):\n # L @ A[:,:,p] batch via gather complex; just benchmark dense contraction for both bits\n L0=jnp.einsum('ba,ab->b?',L,A[:,:,0])\n L1=jnp.einsum('ba,ab->b?',L,A[:,:,1])\n return L0,L1\nupd_j=jax.jit(upd)\nprint('compile q'); t=time.time(); step_j(L,R).block_until_ready(); print('q',time.time()-t)\nprint('compile upd'); t=time.time(); upd_j(L).block_until_ready(); print('upd',time.time()-t)\n# loop 49\nimport time\nt=time.time(); Lcur=L\nfor i in range(49):\n q=step_j(Lcur,R)[0]\n Lcur=upd_j(Lcur)[1]\n jax.block_until_ready(Lcur)\nprint('49 q+upd',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
