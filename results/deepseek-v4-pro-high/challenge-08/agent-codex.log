{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_peps_amp.py <<'PY'\nimport numpy as np, math, time, sys\nimport tensorcircuit as tc\nimport tensornetwork as tn\n\ntc.set_backend('numpy')\nbackend=tc.backend\n\ndef _labels(n):\n return 'a','b',['c','d','e','f','g'][:n]\n\ndef apply_single(U, cur, axes):\n old,new,existing=_labels(len(axes))\n return np.einsum(new+old+','+old+''.join(existing)+'->'+new+''.join(existing), U, cur)\n\ndef apply_left(A, cur, axes):\n nb=len(axes); old,new,existing=_labels(nb); bond=chr(ord('h')+nb)\n return np.einsum(new+old+bond+','+old+''.join(existing)+'->'+new+''.join(existing)+bond, A, cur)\n\ndef apply_right(A, cur, axes):\n nb=len(axes); old,new,existing=_labels(nb); bond=chr(ord('h')+nb)\n return np.einsum(bond+new+old+','+old+''.join(existing)+'->'+new+''.join(existing)+bond, A, cur)\n\ndef split_zzxx(gate, left_site):\n a=np.asarray(gate.tensor)\n a=np.transpose(a,(0,2,1,3))\n M=a.reshape(4,4)\n u,s,vh,_=backend.svd(M)\n chi=2\n u=u[:,:chi].reshape(2,2,chi)\n vh=vh[:chi,:].reshape(chi,2,2)\n u=u*s[:chi][None,None,:]\n return u if left_site else vh\n\ndef build_site(r,c,s,cfg):\n vec0=np.array([1,0],dtype=np.complex64); cur=vec0; axes=[]\n cur=apply_single(np.asarray(tc.gates.ry(theta=alpha(r,c,cfg)).tensor),cur,axes)\n if c>0:\n  A=split_zzxx(tc.gates.rzz(theta=beta_h(r,c-1,c-1,cfg)), False)\n  cur=apply_right(A,cur,axes); axes.append('h')\n if c<s-1:\n  A=split_zzxx(tc.gates.rzz(theta=beta_h(r,c,c,cfg)), True)\n  cur=apply_left(A,cur,axes); axes.append('h')\n if r>0:\n  A=split_zzxx(tc.gates.rxx(theta=beta_v(r-1,c,(r-1)*s+c,cfg)), False)\n  cur=apply_right(A,cur,axes); axes.append('v')\n if r<s-1:\n  A=split_zzxx(tc.gates.rxx(theta=beta_v(r,c,r*s+c,cfg)), True)\n  cur=apply_left(A,cur,axes); axes.append('v')\n cur=apply_single(np.asarray(tc.gates.rx(theta=gamma(r,c,cfg)).tensor),cur,axes)\n return cur\n\ndef alpha(r,c,cfg): return cfg['ry_offset']+cfg['ry_row_s