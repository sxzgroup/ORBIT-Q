{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport jax, jax.numpy as jnp, time, numpy as np\nB=8192; chi=128; n=49\nkey=jax.random.PRNGKey(0)\nA=jax.random.normal(key,[chi,chi,2],dtype=jnp.float32)\nL=jax.random.normal(jax.random.PRNGKey(1),[B,chi],dtype=jnp.float32)\nR=jax.random.normal(jax.random.PRNGKey(2),[B,chi],dtype=jnp.float32)\n# JIT function compute p for both bits and update for one bit\n@jax.jit\ndef step(L,R,A,bit):\n    # q = L @ (A_p @ R?) for each p; use einsum\n    # q shape B,2: einsum('ba,abp,bc->bp',L,A,R)\n    q=jnp.einsum('ba,abp,bc->bp',L,A,R)\n    # update L2 = L @ A[:,:,bit] -> shape B,chi (for all batch use one-hot bit)\n    # choose argmax no; but to benchmark compute both updates\n    L0=jnp.einsum('ba,ab->b?')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
