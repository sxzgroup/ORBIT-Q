{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_compact.py <<'PY'\nimport numpy as np, math, time\nimport tensorcircuit as tc, tensornetwork as tn\ntc.set_backend('numpy')\nb=tc.backend\n# paste helper\ndef _labels(n): return 'a','b',['c','d','e','f','g'][:n]\ndef apply_single(U,cur,axes):\n old,new,existing=_labels(len(axes)); return np.einsum(new+old+','+old+''.join(existing)+'->'+new+''.join(existing),U,cur)\ndef apply_left(A,cur,axes):\n nb=len(axes); old,new,existing=_labels(nb); bond=chr(ord('h')+nb); return np.einsum(new+old+bond+','+old+''.join(existing)+'->'+new+''.join(existing)+bond,A,cur)\ndef apply_right(A,cur,axes):\n nb=len(axes); old,new,existing=_labels(nb); bond=chr(ord('h')+nb); return np.einsum(bond+new+old+','+old+''.join(existing)+'->'+new+''.join(existing)+bond,A,cur)\ndef split(g,left):\n a=np.asarray(g.tensor); a=np.transpose(a,(0,2,1,3)); M=a.reshape(4,4); u,s,vh,_=b.svd(M); u2=u[:,:2].reshape(2,2,2)*s[:2][None,None,:]; v2=vh[:2,:].reshape(2,2,2); return u2 if left else v2\ndef alpha(r,c,cfg): return cfg['ry_offset']+cfg['ry_row_sin_scale']*math.sin(cfg['ry_row_sin_frequency']*(r+1))+cfg['ry_col_cos_scale']*math.cos(cfg['ry_col_cos_frequency']*(c+1))+cfg['ry_diag_sin_scale']*math.sin(cfg['ry_diag_sin_frequency']*(r+c+2))\ndef gamma(r,c,cfg): return cfg['rx_offset']+cfg['rx_row_cos_scale']*math.cos(cfg['rx_row_cos_frequency']*(r+1))-cfg['rx_col_sin_scale']*math.sin(cfg['rx_col_sin_frequency']*(c+1))+cfg['rx_diag_cos_scale']*math.cos(cfg['rx_diag_cos_frequency']*(r+c+2))\ndef bh(r,c,k,cfg): return cfg['rzz_offset']+cfg['rzz_edge_sin_scale']*math.sin(cfg['rzz_edge_sin_frequency']*(k+1))+cfg['rzz_site_cos_scale']*math.cos(cfg['rzz_site_cos_frequency']*(2*r+c+1))\ndef bv(r,c,k,cfg): return cfg['rxx_offset']+cfg['rxx_edge_cos_scale']*math.cos(cfg['rxx_edge_cos_frequency']*(k+1))+cfg['rxx_site_sin_scale']*math.sin(cfg['rxx_site_sin_frequency']*(r+2*c+1))\ndef build_site(r,c,s,cfg):\n cur=np.array([1,0],dtype=np.complex64); axes=[]; cur=apply_single(np.asarray(tc.gates.ry(theta=alpha(r,c,cfg)).tensor),cur,axes)\n if c>0: cur=apply_right(split(tc.gates.rzz(theta=bh(r,c-1,r*(s-1)+c-1,cfg)),False),cur,axes); axes.append('h')\n if c<s-1: cur=apply_left(split(tc.gates.rzz(theta=bh(r,c,r*(s-1)+c,cfg)),True),cur,axes); axes.append('h')\n if r>0: cur=apply_right(split(tc.gates.rxx(theta=bv(r-1,c,(r-1)*s+c,cfg)),False),cur,axes); axes.append('v')\n if r<s-1: cur=apply_left(split(tc.gates.rxx(theta=bv(r,c,r*s+c,cfg)),True),cur,axes); axes.append('v')\n cur=apply_single(np.asarray(tc.gates.rx(theta=gamma(r,c,cfg)).tensor),cur,axes); return cur\ndef bond_pos(r,c,s):\n pos=1; L=R=U=D=None\n if c>0: L=pos; pos+=1\n if c<s-1: R=pos; pos+=1\n if r>0: U=pos; pos+=1\n if r<s-1: D=pos; pos+=1\n return L,R,U,D\ncfg=dict(grid_side=7,n_qubits=49,n_samples=8192,ry_offset=0.19,ry_row_sin_scale=0.07,ry_row_sin_frequency=0.83,ry_col_cos_scale=0.05,ry_col_cos_frequency=0.61,ry_diag_sin_scale=0.03,ry_diag_sin_frequency=0.29,rzz_offset=0.31,rzz_edge_sin_scale=0.09,rzz_edge_sin_frequency=0.47,rzz_site_cos_scale=0.06,rzz_site_cos_frequency=0.38,rxx_offset=0.27,rxx_edge_cos_scale=0.08,rxx_edge_cos_frequency=0.41,rxx_site_sin_scale=0.07,rxx_site_sin_frequency=0.33,rx_offset=0.17,rx_row_cos_scale=0.06,rx_row_cos_frequency=0.52,rx_col_sin_scale=0.04,rx_col_sin_frequency=0.44,rx_diag_cos_scale=0.02,rx_diag_cos_frequency=0.25)\ns=7\nnodes=[]\nfor r in range(s):\n row=[]\n for c in range(s): row.append(tn.Node(build_site(r,c,s,cfg)))\n nodes.append(row)\nfor r in range(s):\n for c in range(s-1):\n  _,R,_,_=bond_pos(r,c,s); L2,_,_,_=bond_pos(r,c+1,s); nodes[r][c][R]\"'^nodes[r][c+1][L2]\nfor r in range(s-1):\n for c in range(s):\n  L,R,U,D=bond_pos(r,c,s); L2,R2,U2,D2=bond_pos(r+1,c,s); nodes[r][c][D]''^nodes[r+1][c][U2]\nalln=[n for row in nodes for n in row]\nfront=[nodes[r][c][0] for r in range(s) for c in range(s)]\nprint('\"'nodes',len(alln),'front',len(front))\n# copy ket/bra\nndict,edict=tn.copy(alln)\nket=alln\nbra=[ndict[n] for n in alln]\nkf=[front]\nbf=[[edict[e] for e in front]]  # wrong edict mapping for edges list? tn.copy returns dict edges original->new\n# Let's use copy_nodes-like manually via tc base? Simpler use two independent fresh construction? But copy should map.\nnewfront=[edict[e] for e in front]\nprint('copied',len(bra),len(newfront))\n# For marginal of first physical: connect all physical edges i\"'!=0 between ket and bra; output [ketfront[0],brafront[0]]\nnewnodes=ket+bra\nfor i,(e1,e2) in enumerate(zip(front,newfront)):\n if i!=0:\n  e1 ''^ e2\nt=time.time()\nres=tc.contractor(newnodes, output_edge_order=[front[0],newfront[0]])\nprint('\"'marginal time',time.time()-t,'shape',res.tensor.shape,res.tensor)\nPY\npython /tmp/bench_compact.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
