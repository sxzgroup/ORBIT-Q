{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix);YY=tc.backend.convert_to_tensor(tc.gates._yy_matrix);ZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\ndef two_body(a,b,c):\n def e1(U,th): return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr)-1j*tc.backend.sin(th)*U\n return tc.backend.reshape(e1(XX,a)@e1(YY,b)@e1(ZZ,c),(2,2,2,2))\ndef qmps_to_tensors(state):\n ts=[];N=len(state.tensors)\n for i,t in enumerate(state.tensors):\n  a=np.asarray(t.data)\n  if i==0:a=np.transpose(a,(1,0))[None,:,:]\n  elif i==N-1:a=a[:,:,None]\n  else:a=np.transpose(a,(0,2,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\ndef h_to_tensors(H):\n ts=[];N=len(H.tensors)\n for i,t in enumerate(H.tensors):\n  a=np.asarray(t.data)\n  if i==0:a=np.transpose(a,(1,2,0))[None,:,:,:]\n  elif i==N-1:a=a[:,:,:,None]\n  else:a=np.transpose(a,(0,2,3,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\nn=8;layers=2\npsi=qtn.MPS_rand_state(n,bond_dim=8);psi/=(psi.H@psi)**0.5\ninit=qmps_to_tensors(psi);H=h_to_tensors(qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False))\nnp_=layers*n*3+sum((n//2 if l%2==0 else n//2-1)*3 for l in range(layers))\ndef energy(params):\n m=tc.MPSCircuit(n,tensors=init,center_position=0);p=0\n for l in range(layers):\n  for i in range(n):m.rz(i,theta=params[p]);p+=1;m.ry(i,theta=params[p]);p+=1;m.rz(i,theta=params[p]);p+=1\n  st=0 if l%2==0 else 1\n  for i in range(st,n-1,2):m.apply_general_gate(tc.gates.Gate(two_body(params[p],params[p+1],params[p+2])),i,i+1);p+=3\n hk=m.copy();hk.apply_MPO(H,0);return tc.backend.real(m.proj_with_mps(hk,conj=True))\np0=jnp.zeros(np_,dtype=jnp.complex64)\nt=time.time();v,g=tc.backend.value_and_grad(energy)(p0);print('time',time.time()-t,'v',v,'finite',np.isfinite(np.asarray(g)).all())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
