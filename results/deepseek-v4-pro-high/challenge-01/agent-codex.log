ors,0)\n    val=m.proj_with_mps(hk,conj=True)\n    return tc.backend.real(val)\n\np0=jnp.zeros(3*n+1,dtype=jnp.complex64)\nprint('eager',energy(p0))\nv,g=tc.backend.value_and_grad(energy)(p0)\nprint('v',v,'g shape',g.shape,'finite',np.isfinite(np.asarray(g)).all())\nprint('g sample',np.asarray(g[:10]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
