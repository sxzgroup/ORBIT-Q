{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, jax, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quimb2qop\n\ntc.set_backend('jax')\nprint('backend',tc.backend.name)\nn=6\n# create random MPS quimb normalized, convert to tc qop for full circuit\npsi=qtn.MPS_rand_state(n,bond_dim=3)\npsi /= (psi.H @ psi)**0.5\nmps_in=quimb2qop(psi)\n\ndef energy(params):\n    c=tc.Circuit(n,mps_inputs=mps_in)\n    p=0\n    # one layer simple rx/ry/rz and rxx on one bond\n    for i in range(n):\n        c.rz(i, theta=params[p]); p+=1\n        c.ry(i, theta=params[p]); p+=1\n        c.rz(i, theta=params[p]); p+=1\n    c.rxx(0,1,theta=params[p]); p+=1\n    e=0.0\n    for i in range(n-1):\n        e += c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\n    for i in range(n):\n        e += -1.05*c.expectation((tc.gates.x(),[i]))\n    return tc.backend.real(e)\n\nrng=np.random.default_rng(0)\nparams=jnp.array(rng.normal(scale=0.01,size=3*n+1),dtype=jnp.complex64)\nprint('eager value',energy(params))\nv,g=tc.backend.value_and_grad(energy)(params)\nprint('vg',v, 'grad shape',g.shape, 'finite',np.isfinite(np.asarray(g)).all())\nprint('g',np.asarray(g))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
