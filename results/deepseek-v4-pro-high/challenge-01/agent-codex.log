 nparams 138 energy time 1.208 grad time 4.214 v -0.2867814898490906 finite True\nn 10 nparams 174 energy time 0.505 grad time 5.774 v -0.3666980564594269 finite True\nn 12 nparams 210 energy time 0.92 grad time 7.611 v 0.07973377406597137 finite True\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix); YY=tc.backend.convert_to_tensor(tc.gates._yy_matrix); ZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\ndef two_body(a,b,c):\n def e1(U,th): return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr)-1j*tc.backend.sin(th)*U\n return tc.backend.reshape(e1(XX,a)@e1(YY,b)@e1(ZZ,c),(2,2,2,2))\n\ndef qmps_to_tensors(state):\n ts=[];N=len(state.tensors)\n for i,t in enumerate(state.tensors):\n  a=np.asarray(t.data)\n  if i==0:a=np.transpose(a,(1,0))[None,:,:]\n  elif i==N-1:a=a[:,:,None]\n  else:a=np.transpose(a,(0,2,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\n\nfor n in [8,10,12]:\n psi=qtn.MPS_rand_state(n,bond_dim=8);psi/=(psi.H@psi)**0.5\n init=qmps_to_tensors(psi)\n layers=4\n np_=layers*n*3+sum((n//2 if l%2==0 else n//2-1)*3 for l in range(layers))\n def energy(params):\n  m=tc.MPSCircuit(n,tensors=init,center_position=0)\n  p=0\n  for l in range(layers):\n   for i in range(n):\n    m.rz(i,theta=params[p]);p+=1\n    m.ry(i,theta=params[p]);p+=1\n    m.rz(i,theta=params[p]);p+=1\n   st=0 if l%2==0 else 1\n   for i in range(st,n-1,2):\n    m.apply_general_gate(tc.gates.Gate(two_body(params[p],params[p+1],params[p+2])),i,i+1);p+=3\n  e=0.0\n  for i in range(n-1):\n   e += m.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\n  for i in range(n):\n   e += -1.05*m.expectation((tc.gates.x(),[i]))\n  return tc.backend.real(e)\n p0=jnp.zeros(np_,dtype=jnp.complex64)\n t=time.time();v,g=tc.backend.value_and_grad(energy)(p0);tg=time.time()-t\n print('n',n,'params',np_,'grad time',round(tg,3),'v',float(v),'finite',np.isfinite(np.asarray(g)).all())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
