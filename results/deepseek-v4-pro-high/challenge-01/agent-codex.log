{"type":"item.completed","item":{"id":"item_116","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport inspect, tensorcircuit.mps_base as mb\nprint(inspect.signature(mb.FiniteMPS.__init__))\nprint(inspect.signature(mb.FiniteMPS.position))\nprint(inspect.getsource(mb.FiniteMPS.position)[:3500])\nPY\"","aggregated_output":"(self, tensors: List[Any], center_position: Optional[int] = None, canonicalize: Optional[bool] = True, backend: Union[str, tensornetwork.backends.abstract_backend.AbstractBackend, NoneType] = None) -> None\n(self, site: int, normalize: Optional[bool] = True, D: Optional[int] = None, max_truncation_err: Optional[float] = None) -> numpy.number\n    def position(\n        self,\n        site: int,\n        normalize: Optional[bool] = True,\n        D: Optional[int] = None,\n        max_truncation_err: Optional[float] = None,\n    ) -> np.number:\n        \"\"\"Shift `center_position` to `site`.\n\n        Args:\n          site: The site to which FiniteMPS.center_position should be shifted\n          normalize: If `True`, normalize matrices when shifting.\n          D: If not `None`, truncate the MPS bond dimensions to `D`.\n          max_truncation_err: if not `None`, truncate each bond dimension,\n            but keeping the truncation error below `max_truncation_err`.\n        Returns:\n          `Tensor`: The norm of the tensor at `FiniteMPS.center_position`\n        Raises:\n          ValueError: If `center_position` is `None`.\n        \"\"\"\n        if self.center_position is None:\n            raise ValueError(\n                \"BaseMPS.center_position is `None`, cannot shift `center_position`.\"\n                \"Reset `center_position` manually or use `canonicalize`\"\n            )\n        if max_truncation_err is not None and max_truncation_err >= 1.0:\n            raise ValueError(\n                \"max_truncation_err should be 0 <= max_truncation_er\"\n                f\" < 1, found max_truncation_err = {max_truncation_err}\"\n            )\n        # `site` has to be between 0 and len(mps) - 1\n        if site >= len(self.tensors) or site < 0:\n            raise ValueError(\n                \"site = {} not between values\"\n                \" 0 < site < N = {}\".format(site, len(self))\n            )\n\n        # nothing to do\n        if site == self.center_position:\n            Z = self.norm(self.tensors[self.center_position])\n            if normalize:\n                self.tensors[self.center_position] /= Z\n            return Z\n\n        # shift center_position to the right using QR or SV decomposition\n        if site > self.center_position:\n            n = self.center_position\n            for n in range(self.center_position, site):\n                use_svd = (\n                    D is not None and D < self.bond_dimension(n + 1)\n                ) or max_truncation_err is not None\n                if not use_svd:\n                    isometry, rest = self.qr(self.tensors[n])\n                else:\n                    isometry, S, V, _ = self.svd(\n                        self.tensors[n], 2, D, max_truncation_err\n                    )\n                    rest = ncon.ncon(\n                        [self.backend.diagflat(S), V],\n                        [[-1, 1], [1, -2]],\n                        backend=self.backend,\n                    )\n\n                self.tensors[n] = isometry\n                self.tensors[n + 1] = ncon.ncon(\n                    [rest, self.tensors[n + 1]],\n                    [[-1, 1], [1, -2, -3]],\n                    backend=self.backend.name,\n                )\n                Z = self.norm(self.tensors[n + 1])\n                # for an mps with > O(10) sites one needs to normalize to avoid\n                # over or underflow errors; this takes care of the normalization\n                if normalize:\n                    self.tensors[n + 1] /= Z\n\n            self.center_position = site\n\n        # shift center_position to the left using RQ or SV decomposition\n        else:\n            for n in reversed(range(site + 1, self.center_position + 1)):\n                use_svd = (\n                    D is not None and D < self.bond_dimension(n)\n                ) or max_truncation_err is not None\n               \n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_117","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nfrom tensorcircuit.mps_base import FiniteMPS\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix);YY=tc.backend.convert_to_tensor(tc.gates._yy_matrix);ZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\ndef two_body(a,b,c):\n def e1(U,th): return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr)-1j*tc.backend.sin(th)*U\n return tc.backend.reshape(e1(XX,a)@e1(YY,b)@e1(ZZ,c),(2,2,2,2))\ndef qmps_to_tensors(state):\n ts=[];N=len(state.tensors)\n for i,t in enumerate(state.tensors):\n  a=np.asarray(t.data)\n  if i==0:a=np.transpose(a,(1,0))[None,:,:]\n  elif i==N-1:a=a[:,:,None]\n  else:a=np.transpose(a,(0,2,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\n\nn=6;layers=1\npsi=qtn.MPS_rand_state(n,bond_dim=8);psi/=(psi.H@psi)**0.5\n# canonicalize using FiniteMPS? just use directly but our random not canonical. canonicalize outside jax numpy? use tc backend maybe\ninit_raw=qmps_to_tensors(psi)\n# canonicalize once outside jit with numpy backend? easier use tc current jax\nm0=FiniteMPS([tc.backend.convert_to_tensor(t) for t in init_raw], center_position=0, canonicalize=False)\n# set to canonicalize? create canonical by position? need canonicalize=True\nm0=FiniteMPS([tc.backend.convert_to_tensor(t) for t in init_raw], center_position=0, canonicalize=True)\ninit=[t for t in m0.tensors]\nprint('init shapes',[t.shape for t in init])\n\ndef apply_layer(tensors, params):\n    m=FiniteMPS([t for t in tensors], center_position=0, canonicalize=False)\n    p=0\n    for i in range(n):\n        m.position(i)\n        m.apply_one_site_gate(tc.gates.rz(theta=params[p]).tensor, i); p+=1\n        m.apply_one_site_gate(tc.gates.ry(theta=params[p]).tensor, i); p+=1\n        m.apply_one_site_gate(tc.gates.rz(theta=params[p]).tensor, i); p+=1\n    for i in range(0,n-1,2):\n        m.position(i)\n        m.apply_two_site_gate(two_body(params[p],params[p+1],params[p+2]),i,i+1,center_position=i); p+=3\n    return tuple(m.tensors)\n\ndef energy(params):\n    tensors=apply_layer(init,params)\n    m=tc.MPSCircuit(n,tensors=list(tensors),center_position=0)\n    return tc.backend.real(m.expectation((tc.gates.z(),[0]),(tc.gates.z(),[1])))\nnp_=n*3+ (n//2)*3\np0=jnp.zeros(np_,dtype=jnp.complex64)\nt=time.time();v=energy(p0);print('eager',time.time()-t,v)\nvg=jax.jit(tc.backend.value_and_grad(energy))\nt=time.time();v,g=vg(p0);print('compile/run',time.time()-t,v,'finite',np.isfinite(np.asarray(g)).all())\nt=time.time();v,g=vg(p0);print('second',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
