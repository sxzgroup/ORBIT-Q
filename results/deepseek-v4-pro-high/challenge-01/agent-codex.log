{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\ntc.set_backend('jax')\n\ndef qmps_to_tensors(state):\n ts=[]\n N=len(state.tensors)\n for i,t in enumerate(state.tensors):\n  a=np.asarray(t.data)\n  if i==0:\n   # (bond_right, phys) -> (1, phys, bond_right)\n   a=np.transpose(a,(1,0))[None,:,:]\n  elif i==N-1:\n   # (bond_left, phys) -> (left, phys, 1)\n   a=a[:,:,None]\n  else:\n   # (left, right, phys) -> (left, phys, right)\n   a=np.transpose(a,(0,2,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\n\ndef h_to_tensors(H):\n ts=[]\n N=len(H.tensors)\n for i,t in enumerate(H.tensors):\n  a=np.asarray(t.data)\n  # quimb internal inds order left,right,out,in? let's print for debug\n  # use inds to map robustly later\n  inds=t.inds\n  # map to left, out, in, right\n  order=[]\n  for label in ['_L','_R']:\n   pass\n  # hardcode based on shape and index\n  if i==0:\n   # (right, out, in) -> (1,out,in,right)\n   a=np.transpose(a,(1,2,0))[None,:,:,:]\n  elif i==N-1:\n   # (left, out, in) -> (left,out,in,1)\n   a=a[:,:,:,None]\n  else:\n   # (left, right, out, in) -> (left,out,in,right)\n   a=np.transpose(a,(0,2,3,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\n\nn=6\nH=qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False)\nh_tensors=h_to_tensors(H)\nprint('ht shapes',[tuple(t.shape) for t in h_tensors])\npsi=qtn.MPS_rand_state(n,bond_dim=3);psi/=(psi.H@psi)**0.5\nprint('quimb',[t.data.shape for t in psi.tensors])\ninit=qmps_to_tensors(psi)\nprint('init',[tuple(t.shape) for t in init])\nm=tc.MPSCircuit(n,tensors=init,center_position=0)\nprint('m',[tuple(t.shape) for t in m._mps.tensors],m._mps.center_position)\n\ndef make_state(params):\n m=tc.MPSCircuit(n,tensors=init,center_position=0)\n p=0\n for i in range(n):\n  m.rz(i,theta=params[p]);p+=1\n  m.ry(i,theta=params[p]);p+=1\n  m.rz(i,theta=params[p]);p+=1\n m.rxx(0,1,theta=params[p]);p+=1\n return m\n\ndef energy(params):\n m=make_state(params)\n hk=m.copy()\n hk.apply_MPO(h_tensors,0)\n val=m.proj_with_mps(hk,conj=True)\n return tc.backend.real(val)\n\np0=jnp.zeros(3*n+1,dtype=jnp.complex64)\nprint('eager',energy(p0))\nv,g=tc.backend.value_and_grad(energy)(p0)\nprint('v',v,'g shape',g.shape,'finite',np.isfinite(np.asarray(g)).all())\nprint('g sample',np.asarray(g[:10]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
