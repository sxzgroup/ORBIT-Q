thout actually performing the required computation. \n   1922       02:11 /bin/bash -c python - <<'PY' import time, numpy as np, jax, jax.numpy as jnp import quimb.tensor as qtn import tensorcircuit as tc from tensorcircuit.quantum import quimb2qop tc.set_backend('jax')  XX=tc.backend.convert_to_tensor(tc.gates._xx_matrix);YY=tc.backend.convert_to_tensor(tc.gates._yy_matrix);ZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix) def two_body(a,b,c):  def e1(U,th): return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr)-1j*tc.backend.sin(th)*U  return tc.backend.reshape(e1(XX,a)@e1(YY,b)@e1(ZZ,c),(2,2,2,2))  for n in [8,10,12]:  psi=qtn.MPS_rand_state(n,bond_dim=8);psi/=(psi.H@psi)**0.5  mps_in=quimb2qop(psi)  Hq=quimb2qop(qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False))  layers=4  np_=layers*n*3+sum((n//2 if l%2==0 else n//2-1)*3 for l in range(layers))  def energy(params):   c=tc.Circuit(n,mps_inputs=mps_in);p=0   for l in range(layers):    for i in range(n):     c.rz(i,theta=params[p]);p+=1;c.ry(i,theta=params[p]);p+=1;c.rz(i,theta=params[p]);p+=1    st=0 if l%2==0 else 1    for i in range(st,n-1,2):     c.apply_general_gate(tc.gates.Gate(two_body(params[p],params[p+1],params[p+2])),i,i+1);p+=3   ket=c.get_quvector();return tc.backend.real((ket.adjoint()@Hq@ket).eval())  p0=jnp.zeros(np_,dtype=jnp.complex64)  vg=jax.jit(tc.backend.value_and_grad(energy))  t=time.time();v,g=vg(p0);print('n',n,'compile',time.time()-t)  t=time.time()  for _ in range(2): v,g=vg(p0)  print('n',n,'run', (time.time()-t)/2,'v',v,'finite',np.isfinite(np.asarray(g)).all()) PY\n   1923       02:11 python -\n   1987       00:00 /bin/bash -c ps -eo pid,etime,cmd | grep -E 'python|PID' | head\n   1989       00:00 grep -E python|PID\n","exit_code":0,"status":"completed"}}
