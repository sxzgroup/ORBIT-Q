{"type":"item.started","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax.numpy as jnp\nimport opt_einsum as oe\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quimb2qop\nfrom tensornetwork import ncon\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix);YY=tc.backend.convert_to_tensor(tc.gates._yy_matrix);ZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\ndef two_body(a,b,c):\n def e1(U,th): return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr)-1j*tc.backend.sin(th)*U\n return tc.backend.reshape(e1(XX,a)@e1(YY,b)@e1(ZZ,c),(2,2,2,2))\n\nn=8;layers=2\npsi=qtn.MPS_rand_state(n,bond_dim=8);psi/=(psi.H@psi)**0.5\nmps_in=quimb2qop(psi)\nHq=quimb2qop(qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False))\nnp_=layers*n*3+sum((n//2 if l%2==0 else n//2-1)*3 for l in range(layers))\n\ndef build_network(params):\n c=tc.Circuit(n,mps_inputs=mps_in);p=0\n for l in range(layers):\n  for i in range(n):\n   c.rz(i,theta=params[p]);p+=1;c.ry(i,theta=params[p]);p+=1;c.rz(i,theta=params[p]);p+=1\n  st=0 if l%2==0 else 1\n  for i in range(st,n-1,2):\n   c.apply_general_gate(tc.gates.Gate(two_body(params[p],params[p+1],params[p+2])),i,i+1);p+=3\n ket=c.get_quvector();scalar=ket.adjoint()@Hq@ket\n return scalar\n\ndef get_path(network):\n nodes=sorted(network.nodes,key=lambda node:getattr(node,'_stable_id_',-1))\n all_edges=tc.cons.tn.get_all_edges(nodes)\n all_edges_sorted=tc.cons.sorted_edges(all_edges)\n mapping={}\n from tensorcircuit.cons import get_symbol\n i=0\n for edge in all_edges_sorted:\n  if id(edge) not in mapping:\n   mapping[id(edge)]=get_symbol(i);i+=1\n input_sets=[list(mapping[id(e)] for e in node.edges) for node in nodes]\n output_set=list(mapping[id(e)] for e in tc.cons.sorted_edges(tc.cons.tn.get_subgraph_dangling(nodes)))\n size_dict={mapping[id(edge)]:edge.dimension for edge in all_edges_sorted}\n path,info=oe.contract_path(input_sets,output_set,size_dict,path='greedy')\n return path\n\nnet=build_network(jnp.zeros(np_,dtype=jnp.complex64))\npath=get_path(net)\nprint('path len',len(path),'first',path[:5])\n# set custom contractor returning path\ndef opt(inputs,output,size_dict,memory_limit=None):\n return path\ntc.set_contractor('custom',optimizer=opt)\nprint('contractor',tc.contractor)\n\ndef energy(params):\n net=build_network(params)\n return tc.backend.real(net.eval())\np0=jnp.zeros(np_,dtype=jnp.complex64)\nt=time.time();v=energy(p0);print('energy',time.time()-t,v)\nt=time.time();v,g=tc.backend.value_and_grad(energy)(p0);print('grad',time.time()-t,v,'finite',np.isfinite(np.asarray(g)).all())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
