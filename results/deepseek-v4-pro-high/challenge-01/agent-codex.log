{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quimb2qop\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix)\nYY=tc.backend.convert_to_tensor(tc.gates._yy_matrix)\nZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\n\ndef two_body(a,b,c):\n    def e1(U,th):\n        return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr) - 1j*tc.backend.sin(th)*U\n    U=e1(XX,a) @ e1(YY,b) @ e1(ZZ,c)\n    return tc.backend.reshape(U,(2,2,2,2))\n\ndef build(n, layers):\n    H=qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False)\n    Hq=quimb2qop(H)\n    psi=qtn.MPS_rand_state(n,bond_dim=8); psi/=(psi.H@psi)**0.5\n    mps_in=quimb2qop(psi)\n    nparams=layers*n*3 + sum((n//2 if l%2==0 else n//2-1)*3 for l in range(layers))\n    return Hq,mps_in,nparams\n\nfor n in [8,10,12]:\n    layers=4\n    Hq,mps_in,np_=build(n,layers)\n    def energy(params):\n        c=tc.Circuit(n,mps_inputs=mps_in)\n        p=0\n        for l in range(layers):\n            for i in range(n):\n                c.rz(i,theta=params[p]);p+=1\n                c.ry(i,theta=params[p]);p+=1\n                c.rz(i,theta=params[p]);p+=1\n            start=0 if l%2==0 else 1\n            for i in range(start,n-1,2):\n                gate=tc.gates.Gate(two_body(params[p],params[p+1],params[p+2]));p+=3\n                c.apply_general_gate(gate,i,i+1)\n        ket=c.get_quvector(); val=(ket.adjoint() @ Hq @ ket).eval()\n        return tc.backend.real(val)\n    p0=jnp.zeros(np_,dtype=jnp.complex64)\n    t=time.time(); v=energy(p0); te=time.time()-t\n    t=time.time(); v,g=tc.backend.value_and_grad(energy)(p0); tg=time.time()-t\n    print('n',n,'nparams',np_,'energy time',round(te,3),'grad time',round(tg,3),'v',float(v),'finite',np.isfinite(np.asarray(g)).all())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
