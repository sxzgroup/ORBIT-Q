{"type":"item.completed","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit.abstractcircuit as ac, inspect\nprint(inspect.getsource(ac.AbstractCircuit.apply_general_variable_gate_delayed)[:5000])\nprint(inspect.getsource(ac.AbstractCircuit.apply_general_gate_delayed)[:3000])\nPY\"","aggregated_output":"    @staticmethod\n    def apply_general_variable_gate_delayed(\n        gatef: Callable[..., Any],\n        name: Optional[str] = None,\n        mpo: bool = False,\n        diagonal: bool = False,\n    ) -> Callable[..., None]:\n        if name is None:\n            name = getattr(gatef, \"n\")\n\n        def apply(self: \"AbstractCircuit\", *index: int, **vars: Any) -> None:\n\n            split = None\n            localname = name\n            if \"name\" in vars:\n                localname = vars[\"name\"]\n                del vars[\"name\"]\n            if \"split\" in vars:\n                split = vars[\"split\"]\n                del vars[\"split\"]\n\n            if name in diaggates or localname in diaggates:\n                if \"dim\" not in vars:\n                    vars[\"dim\"] = self._d\n                if name in [\"rzm\", \"cmz\"] and \"n\" not in vars:\n                    vars[\"n\"] = len(index)\n\n            gate = gatef(**vars)\n\n            self.apply_general_gate(\n                gate,\n                *index,\n                name=localname,\n                split=split,\n                mpo=mpo,\n                diagonal=diagonal,\n                ir_dict={\n                    \"gatef\": gatef,\n                    \"index\": index,\n                    \"name\": localname,\n                    \"split\": split,\n                    \"mpo\": mpo,\n                    \"diagonal\": diagonal,\n                    \"parameters\": vars,\n                },\n            )\n\n        def apply_list(self: \"AbstractCircuit\", *index: int, **vars: Any) -> None:\n            if isinstance(index[0], int):\n                apply(self, *index, **vars)\n            elif is_sequence(index[0]) or isinstance(index[0], range):\n                for i, ind in enumerate(zip(*index)):\n                    nvars = {}\n                    for k, v in vars.items():\n                        try:\n                            nvars[k] = v[i]\n                        except Exception:  # pylint: disable=W0703\n                            # (TypeError, IndexError) is not enough,\n                            # tensorflow.python.framework.errors_impl.InvalidArgumentError\n                            # not ideally captured here\n                            nvars[k] = v\n                    apply(self, *ind, **nvars)\n            else:\n                raise ValueError(\"Illegal index specification\")\n\n        return apply_list\n\n    @staticmethod\n    def apply_general_gate_delayed(\n        gatef: Callable[[], Gate],\n        name: Optional[str] = None,\n        mpo: bool = False,\n    ) -> Callable[..., None]:\n        # it is more like a register instead of apply\n        # nested function must be utilized, functools.partial doesn't work for method register on class\n        # see https://re-ra.xyz/Python-中实例方法动态绑定的几组最小对立/\n        if name is None:\n            name = getattr(gatef, \"n\")\n        defaultname = name\n\n        def apply(\n            self: \"AbstractCircuit\",\n            *index: int,\n            split: Optional[Dict[str, Any]] = None,\n            name: Optional[str] = None,\n        ) -> None:\n            if name is not None:\n                localname = name\n            else:\n                localname = defaultname\n\n            # split = None\n            gate = gatef()\n            gate_dict = {\"gatef\": gatef}\n\n            self.apply_general_gate(\n                gate,\n                *index,\n                name=localname,\n                split=split,\n                mpo=mpo,\n                ir_dict=gate_dict,\n            )\n\n        def apply_list(self: \"AbstractCircuit\", *index: int, **kws: Any) -> None:\n            if isinstance(index[0], int):\n                apply(self, *index, **kws)\n            elif is_sequence(index[0]) or isinstance(index[0], range):\n                for ind in zip(*index):\n                    apply(self, *ind, **kws)\n            else:\n                raise ValueError(\"Illegal index specification\")\n\n        return apply_list\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix);YY=tc.backend.convert_to_tensor(tc.gates._yy_matrix);ZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\ndef two_body(a,b,c):\n def e1(U,th): return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.dtypestr)-1j*tc.backend.sin(th)*U\n return tc.backend.reshape(e1(XX,a)@e1(YY,b)@e1(ZZ,c),(2,2,2,2))\ndef qmps_to_tensors(state):\n ts=[];N=len(state.tensors)\n for i,t in enumerate(state.tensors):\n  a=np.asarray(t.data)\n  if i==0:a=np.transpose(a,(1,0))[None,:,:]\n  elif i==N-1:a=a[:,:,None]\n  else:a=np.transpose(a,(0,2,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\ndef h_to_tensors(H):\n ts=[];N=len(H.tensors)\n for i,t in enumerate(H.tensors):\n  a=np.asarray(t.data)\n  if i==0:a=np.transpose(a,(1,2,0))[None,:,:,:]\n  elif i==N-1:a=a[:,:,:,None]\n  else:a=np.transpose(a,(0,2,3,1))\n  ts.append(tc.backend.convert_to_tensor(a))\n return ts\n\nfor n in [6,8]:\n psi=qtn.MPS_rand_state(n,bond_dim=8);psi/=(psi.H@psi)**0.5\n init=qmps_to_tensors(psi)\n H=h_to_tensors(qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False))\n layers=1\n np_=layers*n*3+((n//2)*3 if True else 0)\n def energy(params):\n  m=tc.MPSCircuit(n,tensors=init,center_position=0);p=0\n  for l in range(layers):\n   for i in range(n):\n    m.rz(i,theta=params[p]);p+=1;m.ry(i,theta=params[p]);p+=1;m.rz(i,theta=params[p]);p+=1\n   for i in range(0,n-1,2):\n    m.apply_general_gate(tc.gates.Gate(two_body(params[p],params[p+1],params[p+2])),i,i+1);p+=3\n  hk=m.copy();hk.apply_MPO(H,0)\n  return tc.backend.real(m.proj_with_mps(hk,conj=True))\n p0=jnp.zeros(np_,dtype=jnp.complex64)\n vg=jax.jit(tc.backend.value_and_grad(energy))\n t=time.time();v,g=vg(p0);print('n',n,'compile/run',time.time()-t,'v',v,'finite',np.isfinite(np.asarray(g)).all())\n t=time.time();v,g=vg(p0);print('second',time.time()-t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
