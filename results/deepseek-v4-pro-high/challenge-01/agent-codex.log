{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, jax, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\n\ndef qmps_to_tensors(state):\n    ts=[]\n    for i,t in enumerate(state.tensors):\n        a=np.asarray(t.data)\n        if i==0:\n            a=a[None,:,:]\n        elif i==len(state.tensors)-1:\n            a=a[:,:,None]\n        ts.append(tc.backend.convert_to_tensor(a))\n    return ts\n\ndef h_to_tensors(H):\n    ts=[]\n    for i,t in enumerate(H.tensors):\n        a=np.asarray(t.data)\n        # ensure shape left,out,in,right\n        if a.ndim==3:\n            if i==0:\n                # (right,out,in) -> (1,out,in,right)\n                a=a[None,:,:,:] if False else a\n                # current shape (bond,out,in)\n                a=np.transpose(a,(1,2,0))[None,:,:,:]  # (1,out,in,bond)\n            else:\n                # last (bond,out,in) -> (bond,out,in,1)\n                a=a[:,:,:,None]\n        else:\n            pass\n        ts.append(tc.backend.convert_to_tensor(a))\n    return ts\n\nn=6\nH=qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False)\nh_tensors=h_to_tensors(H)\npsi=qtn.MPS_rand_state(n,bond_dim=3); psi/=(psi.H@psi)**0.5\ninit_tensors=qmps_to_tensors(psi)\n\n# test init construction\nm=tc.MPSCircuit(n,tensors=init_tensors,center_position=0)\nprint('init tensors', [tuple(t.shape) for t in m._mps.tensors])\nprint('center',m._mps.center_position)\n\ndef make_state(params):\n    m=tc.MPSCircuit(n,tensors=init_tensors,center_position=0)\n    p=0\n    for i in range(n):\n        m.rz(i,theta=params[p]);p+=1\n        m.ry(i,theta=params[p]);p+=1\n        m.rz(i,theta=params[p]);p+=1\n    m.rxx(0,1,theta=params[p]);p+=1\n    return m\n\ndef energy(params):\n    m=make_state(params)\n    h=tc.MPSCircuit(n,tensors=[tc.backend.stop_gradient(t) for t in init_tensors],center_position=0)\n    # apply MPO to h? hk = H|psi>? We need original state copy and apply H to copy.\n    hk=m.copy()\n    hk.apply_MPO(h_tensors,0)\n    # compute <m|H|m> = <m|hk> (since hk=H m) if m normalized\n    val=m.proj_with_mps(hk,conj=True)\n    return tc.backend.real(val)\n\n# run energy without grad\np0=jnp.zeros(3*n+1,dtype=jnp.complex64)\nprint('eager',energy(p0))\n# small grad\nv,g=tc.backend.value_and_grad(energy)(p0)\nprint('v',v,'g shape',g.shape,'finite',np.isfinite(np.asarray(g)).all())\nprint('g sample',np.asarray(g[:10]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
