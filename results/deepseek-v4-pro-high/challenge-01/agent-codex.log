{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quimb2qop\ntc.set_backend('jax')\n\nXX=tc.backend.convert_to_tensor(tc.gates._xx_matrix)\nYY=tc.backend.convert_to_tensor(tc.gates._yy_matrix)\nZZ=tc.backend.convert_to_tensor(tc.gates._zz_matrix)\n\ndef two_body(a,b,c):\n    def e1(U,th):\n        # exp(-i th U), U involution\n        return tc.backend.cos(th)*tc.backend.eye(4,dtype=tc.backend.dtypestr) - 1j*tc.backend.sin(th)*U\n    U=e1(XX,a) @ e1(YY,b) @ e1(ZZ,c)\n    return tc.backend.reshape(U,(2,2,2,2))\n\nn=6\nH=qtn.MPO_ham_ising(n,j=1.0,bx=1.05,cyclic=False)\nHq=quimb2qop(H)\npsi=qtn.MPS_rand_state(n,bond_dim=3);psi/=(psi.H@psi)**0.5\nmps_in=quimb2qop(psi)\n\ndef energy(params):\n c=tc.Circuit(n,mps_inputs=mps_in)\n p=0\n for i in range(n):\n  c.rz(i,theta=params[p]);p+=1\n  c.ry(i,theta=params[p]);p+=1\n  c.rz(i,theta=params[p]);p+=1\n gate=tc.gates.Gate(two_body(params[p],params[p+1],params[p+2]));p+=3\n c.apply_general_gate(gate,0,1)\n ket=c.get_quvector(); val=(ket.adjoint() @ Hq @ ket).eval()\n return tc.backend.real(val)\n\np0=jnp.zeros(3*n+3,dtype=jnp.complex64)\nt=time.time();v,g=tc.backend.value_and_grad(energy)(p0);print('time',time.time()-t,'v',v,'finite',np.isfinite(np.asarray(g)).all());print(g)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
