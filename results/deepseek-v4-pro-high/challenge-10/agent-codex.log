{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/test_mpo.py <<'PY'\nimport numpy as np, tensorcircuit as tc, tensornetwork as tn\nfrom tensorcircuit.quantum import QuOperator\nimport jax, jax.numpy as jnp\n\ndef build_tfim_mpo(n, hzz, hx):\n    # backend currently should be jax; tensor shape [out_phys, in_phys, left, right]\n    I = jnp.eye(2, dtype=jnp.complex64)\n    X = jnp.array([[0,1],[1,0]], dtype=jnp.complex64)\n    Z = jnp.array([[1,0],[0,-1]], dtype=jnp.complex64)\n    D=4\n    tensors=[]\n    for i in range(n):\n        M = jnp.zeros((2,2,D,D), dtype=jnp.complex64)\n        # helper set physical op\n        # all sites: identity paths\n        # state 0 -> 0 identity\n        M = M.at[..., 0,0].set(I)\n        # state 3 -> 3 identity\n        M = M.at[..., 3,3].set(I)\n        # X term: 0 -> 1 X, then 1 -> 3 I; for all sites (bulk)\n        M = M.at[..., 0,1].set(hx*X)\n        M = M.at[..., 1,3].set(I)\n        # ZZ start: 0 -> 2 Z\n        M = M.at[..., 0,2].set(Z)\n        # ZZ finish: 2 -> 3 hzz*Z\n        M = M.at[..., 2,3].set(hzz*Z)\n        tensors.append(M)\n    # add direct end X for last site? Already 0->1 X and then requires state1->3 next site, absent at last; so add 0->3 hx*X at last\n    Mlast = tensors[-1]\n    Mlast = Mlast.at[..., 0,3].add(hx*X)\n    tensors[-1] = Mlast\n    nodes=[tn.Node(t) for t in tensors]\n    out_edges=[]; in_edges=[]\n    for i,node in enumerate(nodes):\n        out_edges.append(node[0]); in_edges.append(node[1])\n        if i < n-1:\n            node[3] \"'^ nodes[i+1][2]\n    # boundary vectors\n    left = jnp.zeros((D,), dtype=jnp.complex64); left=left.at[0].set(1.0)\n    right= jnp.zeros((D,), dtype=jnp.complex64); right=right.at[3].set(1.0)\n    ln=tn.Node(left); rn=tn.Node(right)\n    ln[0] ''^ nodes[0][2]\n    rn[0] ''^ nodes[-1][3]\n    return QuOperator(out_edges, in_edges, ref_nodes=[ln,rn])\n\ndef direct_energy(c, hzz, hx):\n    n=c._nqubits; e=0.0\n    for i in range(n): e += hx * tc.backend.real(c.expectation((tc.gates.x(),[i])))\n    for i in range(n-1): e += hzz * tc.backend.real(c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1])))\n    return e\n\ndef mpo_energy(c, mpo):\n    from tensorcircuit.templates.measurements import mpo_expectation\n    return mpo_expectation(c, mpo)\n\nfor b in ['\"'numpy','jax']:\n print('backend',b); tc.set_backend(b); tc.set_dtype('complex64')\n n=5; hzz=-1.0; hx=-1.05\n # deterministic state\n c=tc.Circuit(n)\n c.h(0); c.rx(1,theta=.3); c.ry(2,theta=.7); c.rz(3,theta=.2); c.h(4)\n mpo=build_tfim_mpo(n,hzz,hx)\n de=direct_energy(c,hzz,hx); me=mpo_energy(c,mpo)\n print('direct',de,'mpo',me, 'diff', np.asarray(de)-np.asarray(me))\nPY\npython /tmp/test_mpo.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
